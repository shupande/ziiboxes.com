---
import { site } from "../data/site";
---

<section id="quote" class="section dark">
  <div class="wrap quote-band">
    <div>
      <p class="section-kicker">Request a quote</p>
      <h2>Send the basic packaging details. Get a practical answer back.</h2>
      <p>
        Share the box or bag style, size, quantity and destination. Artwork is helpful, but not required for the first estimate.
        If your project has recycled paper, FSC paper, plastic-free packaging or supplier code requirements, send them before sampling.
      </p>
      <div class="actions">
        <a class="button light" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="button light" href={site.whatsapp}>WhatsApp</a>
      </div>
    </div>
    <form class="quote-form" action="/api/quote" method="post" data-email={site.email} data-quote-form>
      <input name="box_style" placeholder="Box or bag style" autocomplete="off" />
      <input name="quantity" placeholder="Quantity" autocomplete="off" />
      <input name="size" placeholder="Size" autocomplete="off" />
      <input name="destination" placeholder="Destination country" autocomplete="country-name" />
      <input name="contact" placeholder="Email or WhatsApp" autocomplete="email" required />
      <input name="material_finish" placeholder="Material or finish" autocomplete="off" />
      <input type="hidden" name="company_website" tabindex="-1" autocomplete="off" />
      <textarea name="notes" placeholder="Project notes or artwork link"></textarea>
      <div class="turnstile-field cf-turnstile" data-turnstile-widget data-action="turnstile-spin-v2" hidden></div>
      <button class="button gold quote-submit" type="submit">Send quote request</button>
      <p class="quote-status" data-quote-status aria-live="polite"></p>
    </form>
  </div>
</section>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>

<script>
  const quoteForms = document.querySelectorAll("[data-quote-form]");
  const turnstileWidgets = new WeakMap();

  initTurnstile();

  quoteForms.forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const quoteForm = event.currentTarget;
      if (!(quoteForm instanceof HTMLFormElement)) return;

      const status = quoteForm.querySelector("[data-quote-status]");
      const button = quoteForm.querySelector("button[type='submit']");
      if (!(status instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;

      status.textContent = "Sending...";
      status.dataset.state = "";
      button.disabled = true;

      try {
        const response = await fetch(quoteForm.action, {
          method: "POST",
          body: new FormData(quoteForm),
        });

        if (!response.ok) {
          const body = await response.json().catch(() => null);
          throw new Error(body?.error || "Quote request failed");
        }

        quoteForm.reset();
        resetTurnstile(quoteForm);
        status.textContent = "Request sent. We will reply soon.";
        status.dataset.state = "success";
        trackQuoteConversion();
      } catch (error) {
        resetTurnstile(quoteForm);
        const email = quoteForm.dataset.email || "Sales@ZiiBoxes.com";
        const message = error instanceof Error ? error.message : "";
        if (message.includes("anti-spam") || message.includes("Anti-spam")) {
          status.textContent = message;
        } else {
          status.innerHTML = `The request form is being connected. Please email <a href="mailto:${email}">${email}</a> for now.`;
        }
        status.dataset.state = "error";
      } finally {
        button.disabled = false;
      }
    });
  });

  async function initTurnstile() {
    let siteKey = "";

    try {
      const response = await fetch("/api/turnstile-config", { cache: "no-store" });
      if (response.ok) {
        const config = await response.json();
        siteKey = typeof config.siteKey === "string" ? config.siteKey : "";
      }
    } catch {
      siteKey = "";
    }

    if (!siteKey) return;

    const turnstile = await waitForTurnstile();
    if (!turnstile) return;

    quoteForms.forEach((form) => {
      if (!(form instanceof HTMLFormElement)) return;

      const widget = form.querySelector("[data-turnstile-widget]");
      if (!(widget instanceof HTMLElement)) return;

      widget.hidden = false;
      const widgetId = turnstile.render(widget, {
        sitekey: siteKey,
        action: "turnstile-spin-v2",
        theme: "light",
      });
      turnstileWidgets.set(form, widgetId);
    });
  }

  function waitForTurnstile() {
    return new Promise((resolve) => {
      let tries = 0;
      const timer = window.setInterval(() => {
        const turnstile = window["turnstile"];
        if (turnstile && typeof turnstile.render === "function") {
          window.clearInterval(timer);
          resolve(turnstile);
          return;
        }

        tries += 1;
        if (tries > 80) {
          window.clearInterval(timer);
          resolve(null);
        }
      }, 100);
    });
  }

  function resetTurnstile(form) {
    const turnstile = window["turnstile"];
    const widgetId = turnstileWidgets.get(form);
    if (turnstile && widgetId !== undefined && typeof turnstile.reset === "function") {
      turnstile.reset(widgetId);
    }
  }

  function trackQuoteConversion() {
    const conversionData = {
      lead_type: "quote_request",
      form_path: window.location.pathname,
    };

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: "quote_request_submitted",
      ...conversionData,
    });

    if (typeof window.gtag === "function") {
      window.gtag("event", "generate_lead", conversionData);
    }

    window.dispatchEvent(new CustomEvent("quote_request_submitted"));
  }
</script>
