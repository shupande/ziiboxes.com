---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteSection from "../components/QuoteSection.astro";
import { site } from "../data/site";

const icon = (paths: string) => `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">${paths}</svg>`;
const icons = {
  box: icon('<path d="M21 8.2 12 3 3 8.2l9 5.2 9-5.2Z"/><path d="M3 8.2v7.6L12 21l9-5.2V8.2"/><path d="M12 13.4V21"/>'),
  fileCheck: icon('<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v5h4"/><path d="m9.5 15 2 2 4-5"/>'),
  handoff: icon('<path d="M4 16h5l2 2h4l5-5"/><path d="M14 14h2.5a2 2 0 0 1 0 4H12"/><path d="M3 11h6l3 3"/><path d="M8 11V6h8v5"/>'),
  truck: icon('<path d="M3 7h11v10H3z"/><path d="M14 11h4l3 3v3h-7z"/><path d="M7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="M18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/>'),
  clipboard: icon('<path d="M8 4h8v4H8z"/><path d="M6 6H5v15h14V6h-1"/><path d="M8 12h8"/><path d="M8 16h5"/>'),
  sample: icon('<path d="M8 4h8l3 5-7 11L5 9z"/><path d="M5 9h14"/><path d="M9 9l3 11 3-11"/>'),
  factory: icon('<path d="M4 21V9l5 3V9l5 3V6h6v15z"/><path d="M7 17h2"/><path d="M12 17h2"/><path d="M17 17h2"/>'),
  badge: icon('<path d="M12 3 9.8 7.5 5 8.2l3.5 3.4-.8 4.8L12 14l4.3 2.4-.8-4.8L19 8.2l-4.8-.7L12 3Z"/><path d="M8 20h8"/>'),
  clock: icon('<path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z"/><path d="M12 7v5l3 2"/>'),
  card: icon('<path d="M3 6h18v12H3z"/><path d="M3 10h18"/><path d="M7 15h4"/>'),
  headset: icon('<path d="M4 13a8 8 0 0 1 16 0"/><path d="M5 13h3v5H5z"/><path d="M16 13h3v5h-3z"/><path d="M16 18c0 2-2 3-4 3h-1"/>'),
};

const heroProof = [
  { icon: "badge", title: "20+ years", text: "export experience" },
  { icon: "box", title: "China-side", text: "packing support" },
  { icon: "clock", title: "On-time delivery", text: "and updates" },
  { icon: "truck", title: "Export-ready", text: "handoff" },
];

const serviceTiles = [
  {
    icon: "box",
    title: "China-side packing",
    text: "Inner packing, barcode labels, kits and bundles, custom inserts and paper bags before export.",
    href: "/product-packing-service-china/",
  },
  {
    icon: "fileCheck",
    title: "Inspection & QC",
    text: "In-line and final checks with photos and simple notes before products are handed off.",
    href: "/custom-packaging-sample-process/",
  },
  {
    icon: "handoff",
    title: "Export documentation",
    text: "Commercial invoice, packing list, carton details and route notes prepared earlier.",
    href: "/amazon-fba-packaging-prep-china/",
  },
  {
    icon: "truck",
    title: "Export-ready handoff",
    text: "Carton marking, palletizing and warehouse coordination for on-time pickup.",
    href: "/china-packaging-agent/",
  },
];

const homeProducts = [
  {
    title: "Custom Mailer Boxes",
    text: "Ecommerce mailers with branded prints, strong protection and easy assembly.",
    image: "/images/products/custom-mailer-boxes.jpg",
    alt: "Custom mailer boxes for ecommerce packaging",
    href: "/products/custom-mailer-boxes/",
  },
  {
    title: "Rigid Gift Boxes",
    text: "Magnetic, drawer and lift-top rigid boxes for premium presentation.",
    image: "/images/rigid-boxes.jpg",
    alt: "Rigid gift boxes for premium product packaging",
    href: "/products/custom-rigid-boxes/",
  },
  {
    title: "Folding Cartons",
    text: "Printed folding cartons for retail packaging across many industries.",
    image: "/images/products/custom-folding-cartons.jpg",
    alt: "Custom printed folding cartons",
    href: "/products/custom-folding-cartons/",
  },
  {
    title: "Custom Paper Bags",
    text: "Printed paper bags with handles to elevate your unboxing experience.",
    image: "/images/products/custom-retail-paper-bags.jpg",
    alt: "Custom printed paper bags with handles",
    href: "/products/custom-paper-bags/",
  },
  {
    title: "Product Inserts & Inner Packaging",
    text: "EVA, foam, paper inserts and trays to secure and present your product.",
    image: "/images/products/custom-paper-inserts.jpg",
    alt: "Paper inserts and inner packaging",
    href: "/products/custom-paper-inserts/",
  },
  {
    title: "Corrugated Boxes & Shipping Cartons",
    text: "Strong export-grade cartons for protection in transit.",
    image: "/images/products/custom-shipping-boxes.jpg",
    alt: "Corrugated shipping cartons for export",
    href: "/products/custom-shipping-boxes/",
  },
];

const processCards = [
  { num: "1", icon: "clipboard", title: "Share your needs", text: "Send box size, design, quantity and destination." },
  { num: "2", icon: "fileCheck", title: "Get solution & quote", text: "We recommend the right materials and structure." },
  { num: "3", icon: "sample", title: "Sample before bulk", text: "Confirm material, print and structure with a pre-production sample." },
  { num: "4", icon: "factory", title: "Bulk production & QC", text: "Mass production with in-line and final inspection." },
  { num: "5", icon: "truck", title: "Packing & delivery", text: "China-side packing, export docs and handoff to your forwarder." },
];

const confidenceItems = [
  { icon: "fileCheck", title: "20+ years", text: "export experience" },
  { icon: "badge", title: "100% quality", text: "inspection" },
  { icon: "clock", title: "On-time delivery", text: "and updates" },
  { icon: "box", title: "Low MOQ", text: "friendly" },
  { icon: "card", title: "Flexible payment", text: "options" },
  { icon: "headset", title: "Dedicated support", text: "in English" },
];

const featuredGuides = [
  {
    title: "The ultimate guide to custom mailer boxes for ecommerce",
    text: "Materials, sizes, printing and cost tips to build mailer boxes your customers will love.",
    image: "/images/guides/supplier-ecommerce-mailer-boxes.jpg",
    alt: "Custom ecommerce mailer boxes",
    href: "/guides/custom-mailer-box-design-for-shopify/",
  },
  {
    title: "Rigid gift box styles: how to choose the right one",
    text: "Magnetic, drawer, flip-top or book style? Compare structures and use cases.",
    image: "/images/products/custom-rigid-boxes.jpg",
    alt: "Rigid gift box styles",
    href: "/guides/lid-and-base-rigid-boxes/",
  },
  {
    title: "China-side packing checklist for ecommerce sellers",
    text: "A practical checklist for smooth packing, labeling and export handoff.",
    image: "/images/guides/supplier-delivery-packaging-boxes.jpg",
    alt: "Export cartons prepared for ecommerce handoff",
    href: "/guides/amazon-fba-packaging-prep-checklist/",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: site.name,
      url: site.url,
      logo: `${site.url}/images/logo.png`,
      email: site.email,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Shenzhen",
        addressCountry: "CN",
      },
    },
    {
      "@type": "WebSite",
      name: site.name,
      url: site.url,
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the MOQ for custom printed boxes?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "MOQ depends on box structure, material, printing method, surface finish and destination. Send your style, size and quantity to get a practical estimate.",
          },
        },
        {
          "@type": "Question",
          name: "Can ZiiBoxes make custom boxes with logo?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. ZiiBoxes can quote custom logo printing, full-color artwork, Pantone colors, foil stamping, embossing and other paper packaging finishes.",
          },
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Custom Printed Boxes and China-Side Packing Support"
  description="Custom printed boxes, product packing, labels, carton details and freight/FBA handoff support for ecommerce sellers sourcing products from China."
  schema={schema}
>
  <main>
    <section class="hero home-hero">
      <div class="hero-content wrap">
        <div class="hero-copy">
          <p class="eyebrow">Ecommerce packaging from Shenzhen, China</p>
          <h1>Custom printed boxes for ecommerce brands sourcing from China</h1>
          <p class="hero-lede">
            All-in-one packaging services for ecommerce sellers and suppliers: from custom packaging and China-side packing to export-ready handoff.
          </p>
          <div class="actions">
            <a class="button gold" href="/request-a-quote/">Request a quote</a>
            <a class="button light" href="/china-packaging-agent/">Explore solutions</a>
          </div>
        </div>
        <figure class="hero-visual">
          <img src="/images/home-hero-packaging.jpg" alt="Custom printed boxes, rigid gift boxes, folding cartons and paper bags on a dark green background" />
        </figure>
        <div class="hero-proof" aria-label="Key buying points">
          {heroProof.map((item) => (
            <div class="proof-item">
              <span class="proof-icon" aria-hidden="true" set:html={icons[item.icon]} />
              <strong>{item.title}</strong>
              <span>{item.text}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section alt home-support">
      <div class="wrap">
        <div class="section-head compact">
          <div>
            <p class="section-kicker">China-side packing support</p>
            <h2>Pack products and prepare the handoff in one flow.</h2>
          </div>
          <p>We help you save time, reduce risk and get export-ready shipments with clear updates at every step.</p>
        </div>
        <div class="service-grid">
          {serviceTiles.map((item) => (
            <a class="service-card" href={item.href}>
              <span class="service-icon" aria-hidden="true" set:html={icons[item.icon]} />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section alt home-products">
      <div class="wrap">
        <div class="section-head compact">
          <div>
            <p class="section-kicker">Packaging styles</p>
            <h2>Packaging built for your brand and product.</h2>
          </div>
          <p><a class="text-link inline" href="/products/">View all products</a></p>
        </div>
        <div class="product-grid six">
          {homeProducts.map((product) => (
            <a class="product-card" href={product.href}>
              <img src={product.image} alt={product.alt} />
              <div class="product-copy">
                <h3>{product.title}</h3>
                <p>{product.text}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section case-preview-section">
      <div class="wrap case-preview">
        <div class="case-preview-copy">
          <p class="section-kicker">Featured case study</p>
          <h2>UK rigid gift boxes, 20,000 pcs</h2>
          <p>
            For a UK lifestyle brand, we produced 20,000 rigid gift boxes with printed logo, custom insert and barcode labels, delivered on time for launch.
          </p>
          <a class="button gold" href="/case-studies/uk-rigid-gift-boxes/">View full case study</a>
        </div>
        <figure class="case-preview-photo">
          <img src="/images/rigid-boxes.jpg" alt="Rigid lid-and-base gift boxes prepared for a UK packaging project" />
        </figure>
        <div class="case-preview-stats" aria-label="UK gift box project results">
          <div>
            <strong>20,000</strong>
            <span>rigid gift boxes</span>
          </div>
          <div>
            <strong>100%</strong>
            <span>on-time delivery</span>
          </div>
          <div>
            <strong>China</strong>
            <span>Shenzhen, China</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section alt home-process">
      <div class="wrap">
        <div class="section-head compact">
          <div>
            <p class="section-kicker">How it works</p>
            <h2>From sample to shipment, a clear process.</h2>
          </div>
        </div>
        <div class="process-line">
          {processCards.map((item) => (
            <div class="process-card">
              <span class="process-icon" aria-hidden="true" set:html={icons[item.icon]} />
              <span class="process-num">{item.num}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="confidence-strip">
      <div class="wrap">
        <p class="section-kicker">Buyer confidence</p>
        <h2>Why ecommerce brands work with us.</h2>
        <div class="confidence-grid">
          {confidenceItems.map((item) => (
            <div>
              <span class="confidence-icon" aria-hidden="true" set:html={icons[item.icon]} />
              <strong>{item.title}</strong>
              <span class="confidence-text">{item.text}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section alt home-guides">
      <div class="wrap">
        <div class="section-head compact">
          <div>
            <p class="section-kicker">Packaging guides</p>
            <h2>Practical guides to help you package better.</h2>
          </div>
          <p><a class="text-link inline" href="/guides/">View all guides</a></p>
        </div>
        <div class="guide-highlight-grid">
          {featuredGuides.map((guide) => (
            <a class="guide-highlight-card" href={guide.href}>
              <img src={guide.image} alt={guide.alt} />
              <div>
                <h3>{guide.title}</h3>
                <p>{guide.text}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <QuoteSection compact />
  </main>
</BaseLayout>
