---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteSection from "../components/QuoteSection.astro";
import { guideLinks, industries, processSteps, products, site } from "../data/site";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: site.name,
      url: site.url,
      logo: `${site.url}/images/logo.png`,
      email: site.email,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Shenzhen",
        addressCountry: "CN",
      },
    },
    {
      "@type": "WebSite",
      name: site.name,
      url: site.url,
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the MOQ for custom printed boxes?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "MOQ depends on box structure, material, printing method, surface finish and destination. Send your style, size and quantity to get a practical estimate.",
          },
        },
        {
          "@type": "Question",
          name: "Can ZiiBoxes make custom boxes with logo?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. ZiiBoxes can quote custom logo printing, full-color artwork, Pantone colors, foil stamping, embossing and other paper packaging finishes.",
          },
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Custom Printed Boxes Manufacturer in China"
  description="ZiiBoxes makes custom printed boxes and ecommerce packaging from China for Amazon sellers, Shopify stores and retail brands, with packing support near Shenzhen."
  schema={schema}
>
  <main>
    <section class="hero">
      <div class="hero-media" aria-hidden="true">
        <img src="/images/mailer-boxes.jpg" alt="" />
        <img src="/images/rigid-boxes.jpg" alt="" />
        <img src="/images/jewelry-boxes.jpg" alt="" />
        <img src="/images/printing-machine.jpg" alt="" />
        <img src="/images/gift-boxes.jpg" alt="" />
      </div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="hero-content wrap">
        <div>
          <p class="eyebrow">Ecommerce packaging from Shenzhen, China</p>
          <h1>Custom printed boxes for ecommerce brands sourcing from China.</h1>
          <p class="hero-lede">
            Made for Amazon sellers, Shopify stores, Etsy shops and product launches, with optional product packing, checking and warehouse handoff support before export.
          </p>
          <div class="actions">
            <a class="button" href="/request-a-quote/">Start a box quote</a>
            <a class="button light" href="/ecommerce-packaging/">Ecommerce packaging</a>
          </div>
        </div>
        <div class="hero-proof" aria-label="Key buying points">
          <div class="proof-item">
            <strong>20+ years</strong>
            <span>printed paper packaging experience</span>
          </div>
          <div class="proof-item">
            <strong>Amazon ready</strong>
            <span>packaging and FBA prep coordination</span>
          </div>
          <div class="proof-item">
            <strong>China packing</strong>
            <span>packing and checking before export</span>
          </div>
          <div class="proof-item">
            <strong>Shenzhen export</strong>
            <span>carton planning for sea and air freight</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">China packing support</p>
            <h2>Print boxes, pack products and prepare export cartons in one flow.</h2>
          </div>
          <p>
            If your products are already made in China, packaging can be planned before export instead of being fixed later in an overseas warehouse.
            <a class="text-link" href="/ecommerce-packaging/">See ecommerce packaging support</a>
          </p>
        </div>
        <div class="detail-grid">
          <div class="detail-card">
            <h3>Product packing</h3>
            <ul>
              <li>Put suitable products into printed boxes</li>
              <li>Add sleeves, cards, dividers or paper inserts</li>
              <li>Group small sets before export carton packing</li>
            </ul>
          </div>
          <div class="detail-card">
            <h3>Product checks</h3>
            <ul>
              <li>Discuss visual checks before products are packed</li>
              <li>Coordinate third-party testing when buyers require it</li>
              <li>Confirm product condition before warehouse handoff</li>
            </ul>
          </div>
          <div class="detail-card">
            <h3>Amazon and online sellers</h3>
            <ul>
              <li>Packaging for Amazon, Shopify and Etsy products</li>
              <li>Barcode, label and unboxing details planned early</li>
              <li>Small launch runs before repeat orders</li>
            </ul>
          </div>
          <div class="detail-card">
            <h3>Warehouse handoff</h3>
            <ul>
              <li>Prepare goods for freight forwarders or 3PL routes</li>
              <li>Discuss Amazon FBA label and carton requirements</li>
              <li>Provide carton size and weight after packing</li>
            </ul>
          </div>
          <div class="detail-card">
            <h3>Shenzhen export</h3>
            <ul>
              <li>Close to supplier networks and export routes</li>
              <li>Carton size and weight details for freight planning</li>
              <li>Sea freight and air freight packing discussions</li>
            </ul>
          </div>
          <div class="detail-card">
            <h3>Less repeat handling</h3>
            <ul>
              <li>Avoid shipping empty boxes separately when possible</li>
              <li>Reduce repacking work after goods arrive overseas</li>
              <li>Confirm the packing method before bulk production</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">Box styles</p>
            <h2>Start from the box your product actually needs.</h2>
          </div>
          <p>Each page answers buyer questions first: use case, material, MOQ, finishes, sample timing and shipping notes.</p>
        </div>
        <div class="product-grid five">
          {products.map((product) => (
            <a class="product-card" href={`/products/${product.slug}/`}>
              <img src={product.image} alt={product.alt} />
              <div class="product-copy">
                <small>{product.eyebrow}</small>
                <h3>{product.title}</h3>
                <p>{product.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section dark">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">Industry pages</p>
            <h2>Write pages around buyer use cases, not just product names.</h2>
          </div>
          <p>Use these pages to match box structure, material and finish to the product category you sell.</p>
        </div>
        <div class="industry-table">
          {industries.slice(0, 4).map((industry) => (
            <div class="industry-row">
              <h3>
                <a href={`/industries/${industry.slug}/`}>{industry.title.replace("Custom ", "")}</a>
              </h3>
              <p>{industry.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap process">
        <div class="process-image">
          <img src="/images/factory-line.jpg" alt="Packaging assembly line in a clean workshop" />
        </div>
        <div>
          <p class="section-kicker">How quotes work</p>
          <h2>A clear path from idea to export-ready boxes.</h2>
          <div class="steps">
            {processSteps.map((step, index) => (
              <div class="step">
                <div class="step-num">{index + 1}</div>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">Packaging blog</p>
            <h2>Guides for choosing, quoting and improving custom boxes.</h2>
          </div>
          <p>
            Clear answers for buyers comparing box styles, cost, finishes, materials, artwork, inserts and freight.
            <a class="text-link" href="/guides/">View all packaging guides</a>
          </p>
        </div>
        <div class="guide-grid">
          {guideLinks.map((guide) => (
            <a class="guide-card" href={`/guides/${guide.slug}/`}>
              <div>
                <h3>{guide.title}</h3>
                <p>{guide.description}</p>
              </div>
              <span>Guide</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap section-head">
        <div>
          <p class="section-kicker">Responsible packaging</p>
          <h2>Paper box decisions big buyers usually ask about.</h2>
        </div>
        <p>
          Plan material, finish, packing and supplier requirements early so the sample matches your packaging policy, not only your artwork.
          <a class="text-link" href="/responsible-packaging/">Review responsible packaging options</a>
        </p>
      </div>
    </section>

    <QuoteSection />
  </main>
</BaseLayout>
