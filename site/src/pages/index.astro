---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteSection from "../components/QuoteSection.astro";
import { guideLinks, industries, processSteps, products, site } from "../data/site";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: site.name,
      url: site.url,
      logo: `${site.url}/images/logo.png`,
      email: site.email,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Shenzhen",
        addressCountry: "CN",
      },
    },
    {
      "@type": "WebSite",
      name: site.name,
      url: site.url,
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the MOQ for custom printed boxes?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "MOQ depends on box structure, material, printing method, surface finish and destination. Send your style, size and quantity to get a practical estimate.",
          },
        },
        {
          "@type": "Question",
          name: "Can ZiiBoxes make custom boxes with logo?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. ZiiBoxes can quote custom logo printing, full-color artwork, Pantone colors, foil stamping, embossing and other paper packaging finishes.",
          },
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Custom Printed Boxes and China-Side Packing Support"
  description="Custom printed boxes, product packing, labels, carton details and freight/FBA handoff support for ecommerce sellers sourcing products from China."
  schema={schema}
>
  <main>
    <section class="hero">
      <div class="hero-media" aria-hidden="true">
        <img src="/images/mailer-boxes.jpg" alt="" />
        <img src="/images/rigid-boxes.jpg" alt="" />
        <img src="/images/jewelry-boxes.jpg" alt="" />
        <img src="/images/printing-machine.jpg" alt="" />
        <img src="/images/gift-boxes.jpg" alt="" />
      </div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="hero-content wrap">
        <div>
          <p class="eyebrow">Ecommerce packaging from Shenzhen, China</p>
          <h1>Custom printed boxes for ecommerce brands sourcing from China.</h1>
          <p class="hero-lede">
            For ecommerce sellers sourcing from China: custom printed boxes, product packing and export-ready carton details in one local workflow.
          </p>
          <div class="actions">
            <a class="button" href="/request-a-quote/">Start a box quote</a>
            <a class="button light" href="/china-packaging-agent/">China packaging agent</a>
          </div>
        </div>
        <div class="hero-proof" aria-label="Key buying points">
          <div class="proof-item">
            <strong>20+ years</strong>
            <span>printed paper packaging experience</span>
          </div>
          <div class="proof-item">
            <strong>China-side agent</strong>
            <span>packaging, packing and handoff coordination</span>
          </div>
          <div class="proof-item">
            <strong>China packing</strong>
            <span>packing and checking before export</span>
          </div>
          <div class="proof-item">
            <strong>Shenzhen export</strong>
            <span>carton planning for sea and air freight</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">China packing support</p>
            <h2>Print boxes, pack products and prepare the handoff in one flow.</h2>
          </div>
          <p>
            A practical China-side packaging workflow for ecommerce products, gift sets and launches: boxes, packing, labels, carton data and handoff notes.
            <a class="text-link" href="/china-packaging-agent/">See China packaging agent support</a>
          </p>
        </div>
        <div class="detail-grid">
          <div class="detail-card">
            <h3><a href="/product-packing-service-china/">Product packing</a></h3>
            <ul>
              <li>Put suitable products into printed boxes</li>
              <li>Add sleeves, cards, dividers or paper inserts</li>
              <li>Send empty boxes to your China factory if they pack the goods</li>
              <li>Group small sets before export carton packing</li>
            </ul>
          </div>
          <div class="detail-card">
            <h3>Product checks</h3>
            <ul>
              <li>Discuss visual checks before products are packed</li>
              <li>Coordinate third-party testing when you require it</li>
              <li>Confirm product condition before warehouse handoff</li>
            </ul>
          </div>
          <div class="detail-card">
            <h3><a href="/amazon-fba-packaging-prep-china/">Amazon and online sellers</a></h3>
            <ul>
              <li>Packaging for Amazon, Shopify and Etsy products</li>
              <li>Barcode, label and unboxing details planned early</li>
              <li>Small launch runs before repeat orders</li>
            </ul>
          </div>
          <div class="detail-card">
            <h3><a href="/amazon-fba-packaging-prep-china/">Freight and warehouse handoff</a></h3>
            <ul>
              <li>Help connect with a suitable freight forwarder or 3PL route</li>
              <li>Discuss Amazon FBA labels and carton requirements</li>
              <li>Prepare carton size, weight and packing list details</li>
            </ul>
          </div>
          <div class="detail-card">
            <h3><a href="/send-packaging-to-china-supplier/">China domestic delivery</a></h3>
            <ul>
              <li>Deliver finished boxes to your factory, packer or warehouse in China</li>
              <li>Useful when your product supplier handles final packing</li>
              <li>Keep your own freight route if that is already arranged</li>
            </ul>
          </div>
          <div class="detail-card">
            <h3>Less work after arrival</h3>
            <ul>
              <li>Avoid shipping empty boxes separately when possible</li>
              <li>Reduce repacking work after goods arrive in your market</li>
              <li>Confirm packing, labels and handoff steps before bulk production</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section case-preview-section">
      <div class="wrap case-preview">
        <div class="case-preview-copy">
          <p class="section-kicker">Case study</p>
          <h2>UK gift box project: 20,000 rigid lid-and-base boxes.</h2>
          <p>
            A UK customer needed <a href="/custom-rigid-gift-boxes-china/">premium rigid gift boxes</a> and China-side help after production: supplier collection, logistics provider search, container loading and customs paperwork support.
          </p>
          <a class="button gold" href="/case-studies/">Read the case</a>
        </div>
        <figure class="case-preview-photo">
          <img src="/images/rigid-boxes.jpg" alt="Rigid lid-and-base gift boxes prepared for a packaging project" />
        </figure>
        <div class="case-preview-stats" aria-label="UK gift box project results">
          <div>
            <strong>20,000</strong>
            <span>rigid boxes</span>
          </div>
          <div>
            <strong>100%</strong>
            <span>on-time delivery</span>
          </div>
          <div>
            <strong>China</strong>
            <span>supplier collection</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">Box styles</p>
            <h2>Start from the box your product actually needs.</h2>
          </div>
          <p>Each page answers practical questions first: use case, material, MOQ, finishes, sample timing and shipping notes.</p>
        </div>
        <div class="product-grid five">
          {products.map((product) => (
            <a class="product-card" href={`/products/${product.slug}/`}>
              <img src={product.image} alt={product.alt} />
              <div class="product-copy">
                <small>{product.eyebrow}</small>
                <h3>{product.title}</h3>
                <p>{product.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section dark">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">Industry pages</p>
            <h2>Choose packaging by product use case, not only by box name.</h2>
          </div>
          <p>Use these pages to match box structure, material and finish to the product category you sell.</p>
        </div>
        <div class="industry-table">
          {industries.slice(0, 4).map((industry) => (
            <div class="industry-row">
              <h3>
                <a href={`/industries/${industry.slug}/`}>{industry.title.replace("Custom ", "")}</a>
              </h3>
              <p>{industry.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap process">
        <div class="process-image">
          <img src="/images/factory-line.jpg" alt="Packaging assembly line in a clean workshop" />
        </div>
        <div>
          <p class="section-kicker">How quotes work</p>
          <h2>A clear path from idea to export-ready boxes.</h2>
          <div class="steps">
            {processSteps.map((step, index) => (
              <div class="step">
                <div class="step-num">{index + 1}</div>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">Packaging blog</p>
            <h2>Guides for choosing, quoting and improving custom boxes.</h2>
          </div>
          <p>
            Clear answers when you compare box styles, cost, finishes, materials, artwork, inserts and freight.
            <a class="text-link" href="/guides/">View all packaging guides</a>
          </p>
        </div>
        <div class="guide-grid">
          {guideLinks.map((guide) => (
            <a class="guide-card" href={`/guides/${guide.slug}/`}>
              <div>
                <h3>{guide.title}</h3>
                <p>{guide.description}</p>
              </div>
              <span>Guide</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap section-head">
        <div>
          <p class="section-kicker">Responsible packaging</p>
          <h2>Paper box decisions your team may need to document.</h2>
        </div>
        <p>
          Plan material, finish, packing and supplier requirements early so the sample matches your packaging policy, not only your artwork.
          <a class="text-link" href="/responsible-packaging/">Review responsible packaging options</a>
        </p>
      </div>
    </section>

    <QuoteSection />
  </main>
</BaseLayout>
