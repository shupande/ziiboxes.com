const getGuideImage = (guide) => guide.data.image
  ? { src: guide.data.image, alt: guide.data.imageAlt || guide.data.title }
  : guideImages[guide.id];

const { page } = Astro.props;
const pagePath = page.currentPage === 1 ? "/guides/" : `/guides/${page.currentPage}/`;
const pageTitle = page.currentPage === 1 ? "Custom Packaging Blog and Guides" : `Custom Packaging Blog and Guides - Page ${page.currentPage}`;
const pageNumbers = Array.from({ length: page.lastPage }, (_, index) => index + 1);
const allGuides = await getCollection("guides");
const missingGuideImages = allGuides.filter((guide) => !getGuideImage(guide)).map((guide) => guide.id);
if (missingGuideImages.length > 0) {
  throw new Error(`Missing guide images: ${missingGuideImages.join(", ")}`);
}
const sortedGuides = [...allGuides].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.data.order - b.data.order,
);
const featuredGuide = sortedGuides[0];
const featuredImage = getGuideImage(featuredGuide);
const topicLinks = [
  ["Start here", "/guides/custom-box-moq/"],
  ["Box styles", "/guides/rigid-boxes-vs-folding-cartons/"],
  ["Printing & artwork", "/guides/printing-finishes/"],
  ["Ecommerce packing", "/guides/shopify-packaging-checklist/"],
  ["Paper bags", "/guides/custom-paper-bags-with-logo/"],
  ["Freight & handoff", "/guides/freight-forwarder-carton-details/"],
];
const startHereLinks = [
  ["Packaging quote checklist", "/packaging-quote-checklist/"],
  ["What affects custom box cost?", "/guides/custom-box-cost/"],
  ["Artwork file checklist", "/guides/artwork-file-checklist/"],
];
const popularGuides = sortedGuides.slice(0, 5);
---

<BaseLayout
  title={pageTitle}
  description="Packaging guides about custom printed boxes, paper bags, materials, inserts, MOQ, cost, artwork and shipping."
  path={pagePath}
  solidHeader
>
  <main class="guides-page">
    <section class="editorial-hero guides-hero">
      <div class="wrap editorial-hero-grid">
        <div class="editorial-hero-copy">
          <p class="eyebrow">Packaging guides</p>
          <h1>Plan custom packaging with clearer costs and fewer surprises.</h1>
          <p>Practical answers about box styles, paper bags, materials, inserts, MOQ, artwork, packing and freight handoff.</p>
          <a class="button gold" href="#all-guides">Browse all guides</a>
        </div>
        <a class="guides-featured" href={`/guides/${featuredGuide.id}/`}>
          <img src={featuredImage.src} alt={featuredImage.alt} />
          <div>
            <span>Start here</span>
            <h2>{featuredGuide.data.title}</h2>
            <p>{featuredGuide.data.description}</p>
          </div>
        </a>
      </div>
    </section>

    <nav class="guide-topics" aria-label="Packaging guide topics">
      <div class="wrap guide-topic-list">
        <div class="guide-topic-links">
          {topicLinks.map(([title, href]) => <a href={href}>{title}</a>)}
        </div>
        <div class="guide-search" role="search">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-4-4"></path>
          </svg>
          <input
            id="guide-search"
            type="search"
            placeholder="Search guides"
            aria-label="Search all packaging guides"
            aria-controls="guide-list"
            autocomplete="off"
          />
        </div>
      </div>
    </nav>

    <section class="section alt" id="all-guides">
      <div class="wrap guides-layout">
        <div>
          <div class="guide-list-heading">
            <div>
              <p class="section-kicker">Latest guides</p>
              <h2 data-guide-heading>{page.currentPage === 1 ? "Packaging decisions explained clearly." : `More packaging guides - page ${page.currentPage}.`}</h2>
            </div>
            <span aria-live="polite" data-guide-count>{page.total} guides</span>
          </div>
          <div class="guide-list" id="guide-list" data-current-page={page.currentPage}>
            {sortedGuides.map((guide, index) => {
              const image = getGuideImage(guide);
              const guidePage = Math.floor(index / page.size) + 1;
              const searchText = [
                guide.data.title,
                guide.data.description,
                guide.data.category,
              ].join(" ").toLocaleLowerCase();

              return (
                <a
                  class="guide-row"
                  href={`/guides/${guide.id}/`}
                  data-page={guidePage}
                  data-search={searchText}
                  hidden={guidePage !== page.currentPage}
                >
                  <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
                  <div class="guide-row-copy">
                    <span>{guide.data.category}</span>
                    <h2>{guide.data.title}</h2>
                    <p>{guide.data.description}</p>
                    <strong>Read guide</strong>
                  </div>
                </a>
              );
            })}
          </div>
          <p class="guide-search-empty" role="status" hidden>No guides match your search. Try fewer or broader words.</p>
          {page.lastPage > 1 && (
            <nav class="pagination" aria-label="Blog pagination">
              {page.currentPage > 1 ? (
                <a class="pagination-link pagination-wide" href={page.currentPage === 2 ? "/guides/" : `/guides/${page.currentPage - 1}/`}>Previous</a>
              ) : (
                <span class="pagination-link pagination-wide is-disabled">Previous</span>
              )}
              <div class="pagination-pages">
                {pageNumbers.map((pageNumber) => (
                  <a
                    class="pagination-link"
                    href={pageNumber === 1 ? "/guides/" : `/guides/${pageNumber}/`}
                    aria-current={pageNumber === page.currentPage ? "page" : undefined}
                  >
                    {pageNumber}
                  </a>
                ))}
              </div>
              {page.currentPage < page.lastPage ? (
                <a class="pagination-link pagination-wide" href={`/guides/${page.currentPage + 1}/`}>Next</a>
              ) : (
                <span class="pagination-link pagination-wide is-disabled">Next</span>
              )}
            </nav>
          )}
        </div>

        <aside class="guides-sidebar">
          <div class="guides-sidebar-block">
            <LineIcon name="check" />
            <p class="section-kicker">Start here</p>
            <h2>Preparing a packaging quote?</h2>
            <p>Begin with the details that affect structure, price and delivery.</p>
            {startHereLinks.map(([title, href]) => <a href={href}>{title}</a>)}
          </div>
          <div class="guides-sidebar-block popular">
            <p class="section-kicker">Popular guides</p>
            {popularGuides.map((guide, index) => (
              <a href={`/guides/${guide.id}/`}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{guide.data.title}</strong>
              </a>
            ))}
          </div>
          <div class="guides-sidebar-photo">
            <img src="/images/products/custom-paper-inserts.jpg" alt="Paper packaging insert and box structure" loading="lazy" />
            <p>Need help choosing a structure?</p>
            <a href="/request-a-quote/">Send your product details</a>
          </div>
        </aside>
      </div>
    </section>
    <QuoteSection />
  </main>
</BaseLayout>

<script>
  const searchInput = document.querySelector("#guide-search");
  const guideList = document.querySelector("#guide-list");
  const guideHeading = document.querySelector("[data-guide-heading]");
  const guideCount = document.querySelector("[data-guide-count]");
  const emptyMessage = document.querySelector(".guide-search-empty");
  const pagination = document.querySelector(".pagination");

  if (searchInput instanceof HTMLInputElement && guideList instanceof HTMLElement) {
    const guideRows = Array.from(guideList.querySelectorAll(".guide-row"));
    const currentPage = guideList.dataset.currentPage;
    const defaultHeading = guideHeading?.textContent || "";
    const defaultCount = guideCount?.textContent || "";

    const updateGuideResults = () => {
      const query = searchInput.value.trim().toLocaleLowerCase();
      const terms = query.split(/\s+/).filter(Boolean);
      let matches = 0;

      guideRows.forEach((guideRow) => {
        if (!(guideRow instanceof HTMLElement)) return;

        const isMatch = terms.length > 0
          ? terms.every((term) => guideRow.dataset.search?.includes(term))
          : guideRow.dataset.page === currentPage;

        guideRow.hidden = !isMatch;
        if (terms.length > 0 && isMatch) matches += 1;
      });

      if (guideHeading) guideHeading.textContent = terms.length > 0 ? "Search results" : defaultHeading;
      if (guideCount) guideCount.textContent = terms.length > 0 ? `${matches} ${matches === 1 ? "guide" : "guides"}` : defaultCount;
      if (emptyMessage instanceof HTMLElement) emptyMessage.hidden = terms.length === 0 || matches > 0;
      if (pagination instanceof HTMLElement) pagination.hidden = terms.length > 0;
    };

    searchInput.addEventListener("input", updateGuideResults);
    updateGuideResults();
  }
</script>
