const { page } = Astro.props;
const guides = page.data;
const pagePath = page.currentPage === 1 ? "/guides/" : `/guides/${page.currentPage}/`;
const pageTitle = page.currentPage === 1 ? "Custom Packaging Blog and Guides" : `Custom Packaging Blog and Guides - Page ${page.currentPage}`;
const pageNumbers = Array.from({ length: page.lastPage }, (_, index) => index + 1);
const allGuides = await getCollection("guides");
const missingGuideImages = allGuides.filter((guide) => !guideImages[guide.id]).map((guide) => guide.id);
if (missingGuideImages.length > 0) {
  throw new Error(`Missing guide images: ${missingGuideImages.join(", ")}`);
}
---

<BaseLayout
  title={pageTitle}
  description="Packaging guides about custom printed boxes, box styles, materials, inserts, MOQ, cost, artwork and shipping."
  path={pagePath}
  solidHeader
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Guides</p>
        <h1>Custom packaging blog for brands planning paper boxes.</h1>
        <p>Practical pages about box styles, materials, inserts, MOQ, cost, artwork, shipping and responsible packaging decisions.</p>
      </div>
    </section>
    <section class="section alt">
      <div class="wrap guide-list">
        {guides.map((guide) => {
          const image = guideImages[guide.id];

          return (
            <a class="guide-row" href={`/guides/${guide.id}/`}>
              <img src={image.src} alt={image.alt} decoding="async" />
              <div class="guide-row-copy">
                <span>{guide.data.category}</span>
                <h2>{guide.data.title}</h2>
                <p>{guide.data.description}</p>
              </div>
            </a>
          );
        })}
        {page.lastPage > 1 && (
          <nav class="pagination" aria-label="Blog pagination">
            {page.currentPage > 1 ? (
              <a class="pagination-link pagination-wide" href={page.currentPage === 2 ? "/guides/" : `/guides/${page.currentPage - 1}/`}>Previous</a>
            ) : (
              <span class="pagination-link pagination-wide is-disabled">Previous</span>
            )}
            <div class="pagination-pages">
              {pageNumbers.map((pageNumber) => (
                <a
                  class="pagination-link"
                  href={pageNumber === 1 ? "/guides/" : `/guides/${pageNumber}/`}
                  aria-current={pageNumber === page.currentPage ? "page" : undefined}
                >
                  {pageNumber}
                </a>
              ))}
            </div>
            {page.currentPage < page.lastPage ? (
              <a class="pagination-link pagination-wide" href={`/guides/${page.currentPage + 1}/`}>Next</a>
            ) : (
              <span class="pagination-link pagination-wide is-disabled">Next</span>
            )}
          </nav>
        )}
      </div>
    </section>
  </main>
</BaseLayout>
