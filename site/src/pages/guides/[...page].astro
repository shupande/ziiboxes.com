---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LineIcon from "../../components/LineIcon.astro";
import QuoteSection from "../../components/QuoteSection.astro";

export async function getStaticPaths({ paginate }) {
  const guides = await getCollection("guides");
  guides.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.data.order - b.data.order);

  return paginate(guides, { pageSize: 10 });
}

