---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuoteSection from "../../components/QuoteSection.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const allGuides = await getCollection("guides");
const relatedGuides = allGuides
  .filter((item) => item.id !== guide.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.pubDate.toISOString(),
  dateModified: guide.data.updatedDate.toISOString(),
  author: {
    "@type": "Organization",
    name: site.name,
  },
  publisher: {
    "@type": "Organization",
    name: site.name,
    logo: {
      "@type": "ImageObject",
      url: `${site.url}/images/logo.png`,
    },
  },
};
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  path={`/guides/${guide.id}/`}
  solidHeader
  schema={schema}
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">{guide.data.category}</p>
        <h1>{guide.data.title}</h1>
        <p>{guide.data.description}</p>
      </div>
    </section>
    <section class="section alt">
      <article class="wrap prose">
        <Content />
      </article>
    </section>
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">Related reading</p>
            <h2>More custom packaging guides.</h2>
          </div>
          <p>Keep comparing box structure, material, printing, cost and artwork before you request a quote.</p>
        </div>
        <div class="guide-grid">
          {relatedGuides.map((item) => (
            <a class="guide-card" href={`/guides/${item.id}/`}>
              <div>
                <h3>{item.data.title}</h3>
                <p>{item.data.description}</p>
              </div>
              <span>{item.data.category}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
    <QuoteSection />
  </main>
</BaseLayout>
