---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuoteSection from "../../components/QuoteSection.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import InlineQuoteCallout from "../../components/InlineQuoteCallout.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);

// Extract FAQs for FAQPage JSON-LD schema
function extractFaqs(body: string) {
  if (!body) return [];
  const faqParts = body.split(/^## FAQ\s*$/m);
  if (faqParts.length < 2) return [];
  const faqSection = faqParts[1];
  const items: { question: string; answer: string }[] = [];
  const matches = faqSection.matchAll(/^### (.*?)\r?\n+([\s\S]*?)(?=(?:^### |^## |$))/gm);
  for (const match of matches) {
    const question = match[1].trim();
    const answer = match[2].trim().replace(/\r?\n+/g, " ");
    if (question && answer) {
      items.push({ question, answer });
    }
  }
  return items;
}

const faqs = extractFaqs(guide.body || "");

// Contextual related guides: prioritize same category
const allGuides = await getCollection("guides");
const sameCategoryGuides = allGuides
  .filter((item) => item.id !== guide.id && item.data.category === guide.data.category)
  .sort((a, b) => a.data.order - b.data.order);

const otherGuides = allGuides
  .filter((item) => item.id !== guide.id && item.data.category !== guide.data.category)
  .sort((a, b) => a.data.order - b.data.order);

const relatedGuides = [...sameCategoryGuides, ...otherGuides].slice(0, 4);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.pubDate.toISOString(),
  dateModified: guide.data.updatedDate.toISOString(),
  author: {
    "@type": "Organization",
    name: site.name,
  },
  publisher: {
    "@type": "Organization",
    name: site.name,
    logo: {
      "@type": "ImageObject",
      url: `${site.url}/images/logo.png`,
    },
  },
};

const schemas: any[] = [articleSchema];

if (faqs.length > 0) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  });
}
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  path={`/guides/${guide.id}/`}
  solidHeader
  schema={schemas}
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">{guide.data.category}</p>
        <h1>{guide.data.title}</h1>
        <p>{guide.data.description}</p>
      </div>
    </section>

    <section class="section alt">
      <div class="wrap guide-detail-layout">
        <aside class="guide-sticky-sidebar">
          <TableOfContents headings={headings} />
          <div class="sidebar-callout-wrapper">
            <InlineQuoteCallout
              title="Need Custom Box Pricing?"
              subtitle="Get an exact quote with custom dimensions, material options, and shipping rates."
              buttonText="Get Instant Quote"
            />
          </div>
        </aside>

        <article class="prose guide-article-main">
          <Content />
          <div class="inline-article-cta">
            <InlineQuoteCallout />
          </div>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">Related reading</p>
            <h2>More custom packaging guides.</h2>
          </div>
          <p>Keep comparing structure, material, printing, cost and artwork before you request a quote.</p>
        </div>
        <div class="guide-grid">
          {relatedGuides.map((item) => (
            <a class="guide-card" href={`/guides/${item.id}/`}>
              <div>
                <h3>{item.data.title}</h3>
                <p>{item.data.description}</p>
              </div>
              <span>{item.data.category}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <QuoteSection />
  </main>
</BaseLayout>
