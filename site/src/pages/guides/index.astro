const missingGuideImages = guides.filter((guide) => !guideImages[guide.id]).map((guide) => guide.id);
if (missingGuideImages.length > 0) {
  throw new Error(`Missing guide images: ${missingGuideImages.join(", ")}`);
}
---

<BaseLayout
  title="Custom Packaging Blog and Guides"
  description="Packaging guides about custom printed boxes, box styles, materials, inserts, MOQ, cost, artwork and shipping."
  path="/guides/"
  solidHeader
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Guides</p>
        <h1>Custom packaging blog for brands planning paper boxes.</h1>
        <p>Practical pages about box styles, materials, inserts, MOQ, cost, artwork, shipping and responsible packaging decisions.</p>
      </div>
    </section>
    <section class="section alt">
      <div class="wrap guide-list">
        {guides.map((guide) => {
          const image = guideImages[guide.id];

          return (
            <a class="guide-row" href={`/guides/${guide.id}/`}>
              <img src={image.src} alt={image.alt} decoding="async" />
              <div class="guide-row-copy">
                <span>{guide.data.category}</span>
                <h2>{guide.data.title}</h2>
                <p>{guide.data.description}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>
