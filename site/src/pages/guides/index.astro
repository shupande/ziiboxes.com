---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const guides = await getCollection("guides");
guides.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Custom Packaging Blog and Buyer Guides"
  description="Packaging blog and buyer guides about custom printed boxes, box styles, materials, inserts, MOQ, cost, artwork and shipping."
  path="/guides/"
  solidHeader
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Guides</p>
        <h1>Custom packaging blog for paper box buyers.</h1>
        <p>Practical pages about box styles, materials, inserts, MOQ, cost, artwork, shipping and responsible packaging decisions.</p>
      </div>
    </section>
    <section class="section alt">
      <div class="wrap guide-grid">
        {guides.map((guide) => (
          <a class="guide-card" href={`/guides/${guide.id}/`}>
            <div>
              <h3>{guide.data.title}</h3>
              <p>{guide.data.description}</p>
            </div>
            <span>{guide.data.category}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
