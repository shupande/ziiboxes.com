---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteSection from "../components/QuoteSection.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Contact ZiiBoxes"
  description="Contact ZiiBoxes for custom printed paper boxes, packaging samples and export quotes."
  path="/contact/"
  solidHeader
>
  <main class="quote-page contact-page">
    <section class="page-hero quote-page-hero">
      <div class="wrap">
        <p class="eyebrow">Contact</p>
        <h1>Contact ZiiBoxes for a custom packaging quote.</h1>
        <p>Email, WhatsApp or the form below all work. Send the basic project details first, and we can reply with practical options.</p>
      </div>
    </section>
    <section class="section alt">
      <div class="wrap split">
        <div>
          <p class="section-kicker">Before you send</p>
          <h2>A few practical details are enough to start.</h2>
          <p>
            Share the box or bag style, size, quantity, destination country, artwork stage and any China-side packing or supplier delivery request.
          </p>
        </div>
        <div class="note-panel contact-panel">
          <h3>Contact details</h3>
          <dl>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
            </div>
            <div>
              <dt>WhatsApp</dt>
              <dd><a href={site.whatsapp}>Open WhatsApp</a></dd>
            </div>
            <div>
              <dt>Address</dt>
              <dd>{site.location}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
    <QuoteSection />
  </main>
</BaseLayout>
