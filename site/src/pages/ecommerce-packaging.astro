---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteSection from "../components/QuoteSection.astro";
import { site } from "../data/site";

const faqs = [
  {
    q: "Can you pack my products into custom boxes in China?",
    a: "If your product is suitable for this workflow, send the product size, packing steps, quantity, photos and supplier location. The packing work can then be checked case by case before quoting.",
  },
  {
    q: "Is this useful if I sell on Amazon?",
    a: "Yes. If you source products in China, you can plan custom boxes, inserts, barcode space, master cartons and export packing before the goods leave China.",
  },
  {
    q: "Can you help with sea freight packing details?",
    a: "After your box and packing method are confirmed, carton size, packed quantity and weight details can be prepared for your freight planning.",
  },
  {
    q: "Can you send the packaging to my product factory in China?",
    a: "Yes. Finished boxes can be delivered to your supplier, factory, packer, warehouse or consolidation point in China. This is useful when your own product factory will pack the goods.",
  },
  {
    q: "Can you coordinate product inspection or testing in China?",
    a: "You can request basic product and packing checks before production or packing. If your product needs lab testing or a formal report, send the standard or third-party testing requirement before quoting.",
  },
  {
    q: "Can packed goods be delivered to my Amazon FBA route or freight warehouse?",
    a: "Your packed goods can be prepared for handoff to your confirmed freight forwarder, warehouse or Amazon FBA route after labels, carton requirements and the shipment plan are confirmed.",
  },
  {
    q: "Can you help me find a freight forwarder or FBA prep route in China?",
    a: "Yes. If you do not already have a route, suitable freight forwarder, warehouse or FBA prep contacts can be discussed. ZiiBoxes helps coordinate the packaging-side details; the final shipping service is confirmed with the logistics provider.",
  },
  {
    q: "What paperwork can you help prepare?",
    a: "Packing lists, carton quantity, carton size, gross weight, SKU label notes and other handoff details can be prepared after packing. If customs or regulated product documents are required, send the requirement before quoting.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: "Custom Ecommerce Packaging",
      description:
        "Custom ecommerce packaging from China for Amazon sellers, Shopify stores, Etsy shops and subscription box brands sourcing products from China, including product packing, paperwork, inspection coordination and freight handoff support near Shenzhen.",
      url: `${site.url}/ecommerce-packaging/`,
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title="China-Side Ecommerce Packaging and Packing Support"
  description="Custom ecommerce packaging from China with product packing, paperwork, freight forwarder coordination and FBA route handoff support for Amazon and Shopify sellers."
  path="/ecommerce-packaging/"
  solidHeader
  schema={schema}
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Ecommerce packaging</p>
        <h1>Your China-side packaging coordinator for ecommerce products.</h1>
        <p>
          If you source products from China, you can use one local contact to connect custom boxes with product packing, checks, labels, carton data and freight/FBA handoff before shipment.
        </p>
      </div>
    </section>

    <section class="section alt">
      <div class="wrap split">
        <div class="feature-image">
          <img src="/images/products/custom-mailer-boxes.jpg" alt="Custom ecommerce mailer boxes for online sellers" />
        </div>
        <div>
          <p class="section-kicker">Why this matters</p>
          <h2>Let one China-side contact coordinate packaging, packing and shipment prep.</h2>
          <p class="lede-copy">
            If you buy from Chinese factories but sell on Amazon, Shopify or retail channels, the packaging work does not need to wait until the goods arrive.
            ZiiBoxes can coordinate the custom box, packing method, checks, labels, carton details and logistics handoff, so fewer small tasks fall back on your team later.
          </p>
          <a class="text-link" href="/china-packaging-agent/">See China packaging agent support</a>
          <div class="detail-grid">
            <div class="detail-card" id="amazon-seller-packaging">
              <h3><a href="/amazon-fba-packaging-prep-china/">Amazon seller packaging</a></h3>
              <ul>
                <li>Mailer boxes, folding cartons and inserts for private label products</li>
                <li>Barcode and label space planned before artwork approval</li>
                <li>Master carton quantity, size and weight checked after packing</li>
                <li>Freight forwarder or FBA route details discussed before shipment</li>
              </ul>
            </div>
            <div class="detail-card" id="shopify-packaging">
              <h3>Shopify and online store packaging</h3>
              <ul>
                <li>Branded unboxing boxes for online stores and product drops</li>
                <li>Inside print, thank-you cards, sleeves and paper inserts</li>
                <li>Small batch launch planning before larger repeat orders</li>
                <li>Packaging that supports direct-to-consumer presentation</li>
              </ul>
            </div>
            <div class="detail-card" id="etsy-packaging">
              <h3>Etsy and handmade brands</h3>
              <ul>
                <li>Kraft boxes, window boxes, sleeves and simple gift packaging</li>
                <li>Natural paper looks for soap, candles, jewelry and small gifts</li>
                <li>Box structures that can start with lower-risk quantities</li>
                <li>Custom branding without overbuilding the first order</li>
              </ul>
            </div>
            <div class="detail-card" id="subscription-box-packaging">
              <h3>Subscription box packaging</h3>
              <ul>
                <li>Printed mailer boxes for monthly kits and sample campaigns</li>
                <li>Paper inserts and dividers for mixed product sets</li>
                <li>Inside print for retention-focused unboxing</li>
                <li>Carton size planning for repeated shipping programs</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap split">
        <div>
          <p class="section-kicker">China packing support</p>
          <h2>Pack products here, or send boxes to your China supplier.</h2>
          <p class="lede-copy">
            When products are already being made or consolidated in China, packing support can be discussed together with the box quote.
            This can include putting products into printed boxes, sending empty boxes to your product factory, adding paper inserts, grouping small sets, preparing labels and packing finished units into export cartons.
          </p>
          <div class="note-panel" id="china-packing-support">
            <h3><a href="/product-packing-service-china/">What to confirm first</a></h3>
            <ul class="check-list">
              <li>Product size, weight, photos and supplier location in China</li>
              <li>Delivery address if boxes should go to your factory, packer or warehouse</li>
              <li>Exact packing steps, including inserts, cards, labels or sleeves</li>
              <li>Whether the product is fragile, liquid, food-related or regulated</li>
              <li>Finished carton quantity, destination, paperwork needs and shipping deadline</li>
            </ul>
          </div>
        </div>
        <div class="feature-image">
          <img src="/images/factory-line.jpg" alt="Paper packaging workshop for packing and export preparation" />
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">Freight and warehouse handoff</p>
            <h2>Use Shenzhen's cross-border ecommerce network before goods leave China.</h2>
          </div>
          <p>
            Shenzhen has a mature network of ecommerce suppliers, packing teams, freight forwarders, warehouses and Amazon-focused service providers.
            That gives you a practical way to deliver packaging to a China supplier, find the right logistics contact and coordinate checks, paperwork and shipment preparation before export.
          </p>
        </div>
        <div class="detail-grid">
          <div class="detail-card" id="product-inspection-support">
            <h3>Product inspection support</h3>
            <ul>
              <li>Visual checks before products are packed into custom boxes</li>
              <li>Quantity, color, surface and packing condition checks by agreed steps</li>
              <li>Photos or packing notes discussed before shipment when needed</li>
              <li>Useful if you cannot visit Chinese suppliers in person</li>
            </ul>
          </div>
          <div class="detail-card" id="third-party-testing-coordination">
            <h3>Third-party testing coordination</h3>
            <ul>
              <li>Discuss your required testing before final packing</li>
              <li>Coordinate samples or documents when a lab report is required</li>
              <li>Clarify product category, destination market and test standard early</li>
              <li>Keep testing separate from ordinary packaging approval</li>
            </ul>
          </div>
          <div class="detail-card" id="amazon-fba-prep">
            <h3><a href="/amazon-fba-packaging-prep-china/">Amazon FBA route coordination</a></h3>
            <ul>
              <li>Plan barcode, label and carton information before export</li>
              <li>Pack finished units into master cartons based on your instructions</li>
              <li>Prepare packing lists and carton details for your confirmed route</li>
              <li>Useful when products, packaging and freight are all handled from China</li>
            </ul>
          </div>
          <div class="detail-card" id="china-domestic-delivery">
            <h3><a href="/send-packaging-to-china-supplier/">China domestic delivery</a></h3>
            <ul>
              <li>Send finished boxes to your product factory or packing partner in China</li>
              <li>Deliver to a consolidation warehouse when products come from several suppliers</li>
              <li>Useful when you only need packaging production, not final packing</li>
              <li>Share the Chinese address and receiver details before dispatch</li>
            </ul>
          </div>
          <div class="detail-card" id="warehouse-forwarder-delivery">
            <h3>Freight forwarder or warehouse handoff</h3>
            <ul>
              <li>Help discuss suitable freight forwarder, 3PL or warehouse contacts</li>
              <li>Provide carton size, carton weight and quantity details after packing</li>
              <li>Prepare packaging-side paperwork for sea freight, air freight or warehouse receiving</li>
              <li>Reduce the need for repacking after goods arrive in your market</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap prose">
        <h2 id="shenzhen-sea-freight">Shenzhen export and sea freight planning</h2>
        <p>
          Shenzhen is one of China's most active export areas, with access to nearby ports, air freight routes and a dense supplier network.
          If you sell on Amazon, Shopify or retail channels while sourcing from China, the practical advantage is coordination: box production, product checks, product packing, master carton planning, paperwork and freight handoff details can be discussed before the shipment leaves China.
        </p>
        <p>
          The useful details are not only the printed box price. You also need packed carton size, gross weight, quantity per carton and whether the box is mainly for retail display, ecommerce delivery or bulk export.
          These details affect freight quotes, sea freight, air freight, warehouse receiving and final landed cost.
        </p>

        <h2>Box styles for ecommerce sellers</h2>
        <table>
          <thead>
            <tr>
              <th>Seller need</th>
              <th>Useful packaging option</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Product factory packs the goods</td>
              <td>Deliver finished paper boxes to your factory, supplier or packing partner in China.</td>
            </tr>
            <tr>
              <td>Amazon private label product</td>
              <td><a href="/products/custom-folding-cartons/">Folding cartons</a>, paper inserts, product checks, labels and export cartons.</td>
            </tr>
            <tr>
              <td>Shopify or online store unboxing</td>
              <td><a href="/products/custom-mailer-boxes/">Mailer boxes</a> with inside print, cards or inserts.</td>
            </tr>
            <tr>
              <td>Gift set or launch kit</td>
              <td><a href="/products/custom-rigid-boxes/">Rigid boxes</a>, paper inserts and sleeves.</td>
            </tr>
            <tr>
              <td>Subscription program</td>
              <td>Mailer boxes, dividers and consistent carton size planning.</td>
            </tr>
            <tr>
              <td>FBA or freight warehouse handoff</td>
              <td>Carton details, label coordination, paperwork notes and delivery to your confirmed route.</td>
            </tr>
          </tbody>
        </table>

        <div class="faq">
          {faqs.map((item) => (
            <div class="faq-item">
              <strong>{item.q}</strong>
              <p>{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <QuoteSection />
  </main>
</BaseLayout>
