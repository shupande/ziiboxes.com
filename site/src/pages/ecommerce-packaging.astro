---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteSection from "../components/QuoteSection.astro";
import { site } from "../data/site";

const faqs = [
  {
    q: "Can you pack my products into custom boxes in China?",
    a: "If your product is suitable for this workflow, send the product size, packing steps, quantity, photos and supplier location. The packing work can then be checked case by case before quoting.",
  },
  {
    q: "Is this useful if I sell on Amazon?",
    a: "Yes. If you source products in China, you can plan custom boxes, inserts, barcode space, master cartons and export packing before the goods leave China.",
  },
  {
    q: "Can you help with sea freight packing details?",
    a: "After your box and packing method are confirmed, carton size, packed quantity and weight details can be prepared for your freight planning.",
  },
  {
    q: "Can you coordinate product inspection or testing in China?",
    a: "You can request basic product and packing checks before production or packing. If your product needs lab testing or a formal report, send the standard or third-party testing requirement before quoting.",
  },
  {
    q: "Can packed goods be delivered to my Amazon FBA route or freight warehouse?",
    a: "Your packed goods can be prepared for handoff to your freight forwarder, warehouse or Amazon FBA shipping route after labels, carton requirements and the shipment plan are confirmed.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: "Custom Ecommerce Packaging",
      description:
        "Custom ecommerce packaging from China for Amazon sellers, Shopify stores, Etsy shops and subscription box brands sourcing products from China, including packing, inspection coordination and warehouse handoff support near Shenzhen.",
      url: `${site.url}/ecommerce-packaging/`,
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title="Custom Ecommerce Packaging from China"
  description="Custom ecommerce packaging from China for Amazon sellers, Shopify stores and ecommerce brands sourcing products from China, with packing, inspection coordination and warehouse handoff support near Shenzhen."
  path="/ecommerce-packaging/"
  solidHeader
  schema={schema}
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Ecommerce packaging</p>
        <h1>Custom ecommerce packaging for Amazon, Shopify and Etsy sellers.</h1>
        <p>
          If you source products from China, you can print boxes, pack products, coordinate checks and prepare goods for export, freight forwarders or Amazon FBA routes before the shipment leaves China.
        </p>
      </div>
    </section>

    <section class="section alt">
      <div class="wrap split">
        <div class="feature-image">
          <img src="/images/products/custom-mailer-boxes.jpg" alt="Custom ecommerce mailer boxes for online sellers" />
        </div>
        <div>
          <p class="section-kicker">Why this matters</p>
          <h2>If your products are made in China, packaging can be planned closer to the source.</h2>
          <p class="lede-copy">
            If you buy from Chinese factories but sell in another market, the packaging work does not need to wait until the goods arrive.
            You can plan the custom box, packing method, checks, labels and warehouse handoff in China to reduce repeat handling, avoid shipping empty packaging separately and make export carton details clearer before shipment.
          </p>
          <div class="detail-grid">
            <div class="detail-card" id="amazon-seller-packaging">
              <h3>Amazon seller packaging</h3>
              <ul>
                <li>Mailer boxes, folding cartons and inserts for private label products</li>
                <li>Barcode and label space planned before artwork approval</li>
                <li>Master carton quantity, size and weight checked after packing</li>
                <li>Useful when you already source products in China</li>
              </ul>
            </div>
            <div class="detail-card" id="shopify-packaging">
              <h3>Shopify and online store packaging</h3>
              <ul>
                <li>Branded unboxing boxes for online stores and product drops</li>
                <li>Inside print, thank-you cards, sleeves and paper inserts</li>
                <li>Small batch launch planning before larger repeat orders</li>
                <li>Packaging that supports direct-to-consumer presentation</li>
              </ul>
            </div>
            <div class="detail-card" id="etsy-packaging">
              <h3>Etsy and handmade brands</h3>
              <ul>
                <li>Kraft boxes, window boxes, sleeves and simple gift packaging</li>
                <li>Natural paper looks for soap, candles, jewelry and small gifts</li>
                <li>Box structures that can start with lower-risk quantities</li>
                <li>Custom branding without overbuilding the first order</li>
              </ul>
            </div>
            <div class="detail-card" id="subscription-box-packaging">
              <h3>Subscription box packaging</h3>
              <ul>
                <li>Printed mailer boxes for monthly kits and sample campaigns</li>
                <li>Paper inserts and dividers for mixed product sets</li>
                <li>Inside print for retention-focused unboxing</li>
                <li>Carton size planning for repeated shipping programs</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap split">
        <div>
          <p class="section-kicker">China packing support</p>
          <h2>Pack products into the custom box before export.</h2>
          <p class="lede-copy">
            When products are already being made or consolidated in China, packing support can be discussed together with the box quote.
            This can include putting products into printed boxes, adding paper inserts, grouping small sets and packing finished units into export cartons.
          </p>
          <div class="note-panel" id="china-packing-support">
            <h3>What to confirm first</h3>
            <ul class="check-list">
              <li>Product size, weight, photos and supplier location in China</li>
              <li>Exact packing steps, including inserts, cards, labels or sleeves</li>
              <li>Whether the product is fragile, liquid, food-related or regulated</li>
              <li>Finished carton quantity, destination and shipping deadline</li>
            </ul>
          </div>
        </div>
        <div class="feature-image">
          <img src="/images/factory-line.jpg" alt="Paper packaging workshop for packing and export preparation" />
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">Inspection and warehouse handoff</p>
            <h2>Use Shenzhen's cross-border ecommerce workflow before goods leave China.</h2>
          </div>
          <p>
            Shenzhen has a mature network of ecommerce suppliers, packing teams, freight forwarders and Amazon-focused service providers.
            That gives you a practical way to coordinate packaging, checks and shipment preparation before export.
          </p>
        </div>
        <div class="detail-grid">
          <div class="detail-card" id="product-inspection-support">
            <h3>Product inspection support</h3>
            <ul>
              <li>Visual checks before products are packed into custom boxes</li>
              <li>Quantity, color, surface and packing condition checks by agreed steps</li>
              <li>Photos or packing notes discussed before shipment when needed</li>
              <li>Useful if you cannot visit Chinese suppliers in person</li>
            </ul>
          </div>
          <div class="detail-card" id="third-party-testing-coordination">
            <h3>Third-party testing coordination</h3>
            <ul>
              <li>Discuss your required testing before final packing</li>
              <li>Coordinate samples or documents when a lab report is required</li>
              <li>Clarify product category, destination market and test standard early</li>
              <li>Keep testing separate from ordinary packaging approval</li>
            </ul>
          </div>
          <div class="detail-card" id="amazon-fba-prep">
            <h3>Amazon FBA prep coordination</h3>
            <ul>
              <li>Plan barcode, label and carton information before export</li>
              <li>Pack finished units into master cartons based on your instructions</li>
              <li>Support handoff after you confirm shipment labels and carton rules</li>
              <li>Useful when products, packaging and freight are all handled from China</li>
            </ul>
          </div>
          <div class="detail-card" id="warehouse-forwarder-delivery">
            <h3>Forwarder or warehouse delivery</h3>
            <ul>
              <li>Prepare packed goods for your freight forwarder or 3PL route</li>
              <li>Provide carton size, carton weight and quantity details after packing</li>
              <li>Discuss sea freight, air freight or warehouse receiving needs</li>
              <li>Reduce the need for repacking after goods arrive in your market</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap prose">
        <h2 id="shenzhen-sea-freight">Shenzhen export and sea freight planning</h2>
        <p>
          Shenzhen is one of China's most active export areas, with access to nearby ports, air freight routes and a dense supplier network.
          If you sell in another market while sourcing from China, the practical advantage is coordination: box production, product checks, product packing, master carton planning and export details can be discussed before the shipment leaves China.
        </p>
        <p>
          The useful details are not only the printed box price. You also need packed carton size, gross weight, quantity per carton and whether the box is mainly for retail display, ecommerce delivery or bulk export.
          These details affect sea freight, air freight, warehouse receiving and final landed cost.
        </p>

        <h2>Box styles for ecommerce sellers</h2>
        <table>
          <thead>
            <tr>
              <th>Seller need</th>
              <th>Useful packaging option</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Amazon private label product</td>
              <td><a href="/products/custom-folding-cartons/">Folding cartons</a>, paper inserts, product checks, labels and export cartons.</td>
            </tr>
            <tr>
              <td>Shopify or online store unboxing</td>
              <td><a href="/products/custom-mailer-boxes/">Mailer boxes</a> with inside print, cards or inserts.</td>
            </tr>
            <tr>
              <td>Gift set or launch kit</td>
              <td><a href="/products/custom-rigid-boxes/">Rigid boxes</a>, paper inserts and sleeves.</td>
            </tr>
            <tr>
              <td>Subscription program</td>
              <td>Mailer boxes, dividers and consistent carton size planning.</td>
            </tr>
            <tr>
              <td>FBA or freight warehouse handoff</td>
              <td>Carton details, label coordination and delivery to your confirmed route.</td>
            </tr>
          </tbody>
        </table>

        <div class="faq">
          {faqs.map((item) => (
            <div class="faq-item">
              <strong>{item.q}</strong>
              <p>{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <QuoteSection />
  </main>
</BaseLayout>
