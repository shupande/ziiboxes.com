---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteSection from "../components/QuoteSection.astro";
import { processSteps } from "../data/site";
---

<BaseLayout
  title="Custom Packaging Quote and Production Process"
  description="How ZiiBoxes handles custom printed paper packaging quotes, sampling, production, China-side packing and shipping handoff."
  path="/services/"
  solidHeader
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Process</p>
        <h1>One clear path from packaging idea to production.</h1>
        <p>Use this page to understand what information is needed and what happens before mass production, packing or China-side handoff.</p>
      </div>
    </section>
    <section class="section">
      <div class="wrap process">
        <div class="process-image">
          <img src="/images/printing-machine.jpg" alt="Printing and packaging production machine" />
        </div>
        <div class="steps">
          {processSteps.map((step, index) => (
            <div class="step">
              <div class="step-num">{index + 1}</div>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="section alt">
      <div class="wrap detail-grid">
        <div class="detail-card">
          <h3><a href="/packaging-quote-checklist/">Packaging quote checklist</a></h3>
          <p>Send better first details for boxes, paper bags, inserts, samples and supplier delivery.</p>
        </div>
        <div class="detail-card">
          <h3><a href="/custom-packaging-sample-process/">Sample process</a></h3>
          <p>Check structure, size, print, finish and carton details before bulk production.</p>
        </div>
        <div class="detail-card">
          <h3><a href="/case-studies/">Case studies</a></h3>
          <p>See project examples for gift boxes, paper bags, bottle boxes and China-side coordination.</p>
        </div>
      </div>
    </section>
    <QuoteSection />
  </main>
</BaseLayout>
