---
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuoteSection from "../../components/QuoteSection.astro";
import { industries, site } from "../../data/site";

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: industry.title,
  description: industry.description,
  url: `${site.url}/industries/${industry.slug}/`,
};
---

<BaseLayout
  title={industry.title}
  description={industry.description}
  path={`/industries/${industry.slug}/`}
  solidHeader
  schema={schema}
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">{industry.keyword}</p>
        <h1>{industry.title}</h1>
        <p>{industry.description}</p>
        <div class="actions">
          <a class="button gold" href="/request-a-quote/">Request a quote</a>
          <a class="button light" href="/industries/">All industries</a>
        </div>
      </div>
    </section>
    <section class="section alt">
      <div class="wrap split">
        <div class="feature-image">
          <img src={industry.image} alt={industry.title} />
        </div>
        <div>
          <p class="section-kicker">Packaging plan</p>
          <h2>Box styles and details buyers usually compare.</h2>
          <div class="spec-list">
            {industry.products.map((item) => <div class="spec">{item}</div>)}
            {industry.notes.map((item) => <div class="spec">{item}</div>)}
          </div>
          <div class="faq">
            <div class="faq-item">
              <strong>What should I send for a quote?</strong>
              <p>Send product size, box style, quantity, destination and finish requirements. A photo or reference box is also useful.</p>
            </div>
            <div class="faq-item">
              <strong>Can this page support small brand launches?</strong>
              <p>Yes. The first quote can compare a smaller pilot run with a bulk option, so you can understand the cost difference.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <QuoteSection />
  </main>
</BaseLayout>
