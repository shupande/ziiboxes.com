---
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuoteSection from "../../components/QuoteSection.astro";
import { industries, site } from "../../data/site";

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;
const industryGuideLinks: Record<string, [string, string][]> = {
  "custom-cosmetic-boxes": [
    ["Cosmetic gift set packaging", "/cosmetic-gift-set-packaging-china/"],
    ["Skincare gift set packaging", "/guides/skincare-gift-set-packaging/"],
    ["How to choose cosmetic packaging boxes", "/guides/cosmetic-packaging-structure-guide/"],
    ["Paper inserts vs plastic trays", "/guides/paper-inserts-vs-plastic-trays/"],
    ["Printing finishes explained", "/guides/printing-finishes/"],
  ],
  "custom-candle-boxes": [
    ["Candle packaging from China", "/candle-packaging-china/"],
    ["Custom candle box packaging checklist", "/guides/custom-candle-box-packaging-checklist/"],
    ["Glass jar candle packaging protection", "/guides/glass-jar-candle-packaging-protection/"],
    ["Candle gift set packaging and inserts", "/guides/candle-gift-set-packaging-inserts/"],
    ["Custom candle boxes and inserts", "/guides/candle-box-inserts-protection/"],
  ],
  "custom-jewelry-boxes": [
    ["Jewelry boxes with logo", "/guides/jewelry-box-inserts-logo/"],
    ["Rigid boxes vs folding cartons", "/guides/rigid-boxes-vs-folding-cartons/"],
    ["Printing finishes explained", "/guides/printing-finishes/"],
  ],
  "custom-soap-boxes": [
    ["Kraft soap boxes with window", "/guides/kraft-soap-boxes-with-window/"],
    ["Custom box dieline guide", "/guides/custom-box-dieline-guide/"],
    ["Responsible packaging options", "/responsible-packaging/"],
  ],
  "custom-food-packaging-boxes": [
    ["Custom box dieline guide", "/guides/custom-box-dieline-guide/"],
    ["Paper inserts vs plastic trays", "/guides/paper-inserts-vs-plastic-trays/"],
    ["Responsible packaging options", "/responsible-packaging/"],
  ],
  "custom-subscription-boxes": [
    ["Subscription box packaging planning", "/guides/subscription-box-packaging-planning/"],
    ["Shopify packaging from China", "/shopify-packaging-china/"],
    ["Custom mailer box design for Shopify", "/guides/custom-mailer-box-design-for-shopify/"],
  ],
};
const defaultIndustryGuideLinks: [string, string][] = [
  ["Low MOQ custom packaging", "/guides/low-moq-custom-packaging-small-brands/"],
  ["Paper inserts vs plastic trays", "/guides/paper-inserts-vs-plastic-trays/"],
  ["Responsible packaging options", "/responsible-packaging/"],
];
const relatedGuides = industryGuideLinks[industry.slug] ?? defaultIndustryGuideLinks;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: industry.title,
      description: industry.description,
      url: `${site.url}/industries/${industry.slug}/`,
    },
    {
      "@type": "FAQPage",
      mainEntity: industry.faqs.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={industry.title}
  description={industry.description}
  path={`/industries/${industry.slug}/`}
  solidHeader
  schema={schema}
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">{industry.keyword}</p>
        <h1>{industry.title}</h1>
        <p>{industry.description}</p>
        <div class="actions">
          <a class="button gold" href="/request-a-quote/">Request a quote</a>
          <a class="button light" href="/industries/">All industries</a>
        </div>
      </div>
    </section>
    <section class="section alt">
      <div class="wrap split">
        <div class="feature-image">
          <img src={industry.image} alt={industry.title} />
        </div>
        <div>
          <p class="section-kicker">Packaging plan</p>
          <h2>Box styles and details your team may compare.</h2>
          <p class="lede-copy">{industry.description}</p>
          <div class="detail-grid">
            <div class="detail-card">
              <h3>Box styles</h3>
              <ul>
                {industry.products.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="detail-card">
              <h3>Common applications</h3>
              <ul>
                {industry.applications.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="detail-card">
              <h3>Project checks</h3>
              <ul>
                {industry.notes.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="detail-card">
              <h3>Cost control</h3>
              <ul>
                {industry.costTips.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
          <div class="faq">
            {industry.faqs.map((item) => (
              <div class="faq-item">
                <strong>{item.q}</strong>
                <p>{item.a}</p>
              </div>
            ))}
          </div>
          <div class="note-panel">
            <h3>Helpful guides</h3>
            <ul class="link-list">
              {relatedGuides.map(([title, href]) => (
                <li><a href={href}>{title}</a></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
    <QuoteSection />
  </main>
</BaseLayout>
