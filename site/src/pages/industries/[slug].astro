---
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuoteSection from "../../components/QuoteSection.astro";
import { industries, site } from "../../data/site";

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: industry.title,
      description: industry.description,
      url: `${site.url}/industries/${industry.slug}/`,
    },
    {
      "@type": "FAQPage",
      mainEntity: industry.faqs.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={industry.title}
  description={industry.description}
  path={`/industries/${industry.slug}/`}
  solidHeader
  schema={schema}
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">{industry.keyword}</p>
        <h1>{industry.title}</h1>
        <p>{industry.description}</p>
        <div class="actions">
          <a class="button gold" href="/request-a-quote/">Request a quote</a>
          <a class="button light" href="/industries/">All industries</a>
        </div>
      </div>
    </section>
    <section class="section alt">
      <div class="wrap split">
        <div class="feature-image">
          <img src={industry.image} alt={industry.title} />
        </div>
        <div>
          <p class="section-kicker">Packaging plan</p>
          <h2>Box styles and details buyers usually compare.</h2>
          <p class="lede-copy">{industry.description}</p>
          <div class="detail-grid">
            <div class="detail-card">
              <h3>Box styles</h3>
              <ul>
                {industry.products.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="detail-card">
              <h3>Common applications</h3>
              <ul>
                {industry.applications.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="detail-card">
              <h3>Buyer checks</h3>
              <ul>
                {industry.notes.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="detail-card">
              <h3>Cost control</h3>
              <ul>
                {industry.costTips.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
          <div class="faq">
            {industry.faqs.map((item) => (
              <div class="faq-item">
                <strong>{item.q}</strong>
                <p>{item.a}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
    <QuoteSection />
  </main>
</BaseLayout>
