---
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuoteSection from "../../components/QuoteSection.astro";
import { products, site } from "../../data/site";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const productGuideLinks: Record<string, [string, string][]> = {
  "custom-mailer-boxes": [
    ["Mailer boxes vs shipping boxes", "/guides/mailer-boxes-vs-shipping-boxes/"],
    ["Low MOQ custom packaging", "/guides/low-moq-custom-packaging-small-brands/"],
    ["How box size affects freight cost", "/guides/shipping-carton-size-freight-cost/"],
  ],
  "custom-folding-cartons": [
    ["Rigid boxes vs folding cartons", "/guides/rigid-boxes-vs-folding-cartons/"],
    ["Custom box dieline guide", "/guides/custom-box-dieline-guide/"],
    ["How to choose cosmetic packaging boxes", "/guides/cosmetic-packaging-structure-guide/"],
  ],
  "custom-rigid-boxes": [
    ["Rigid boxes vs folding cartons", "/guides/rigid-boxes-vs-folding-cartons/"],
    ["Jewelry boxes with logo", "/guides/jewelry-box-inserts-logo/"],
    ["Paper inserts vs plastic trays", "/guides/paper-inserts-vs-plastic-trays/"],
  ],
  "custom-gift-boxes": [
    ["Custom candle boxes and inserts", "/guides/candle-box-inserts-protection/"],
    ["Paper inserts vs plastic trays", "/guides/paper-inserts-vs-plastic-trays/"],
    ["Printing finishes explained", "/guides/printing-finishes/"],
  ],
  "custom-shipping-boxes": [
    ["Mailer boxes vs shipping boxes", "/guides/mailer-boxes-vs-shipping-boxes/"],
    ["How box size affects freight cost", "/guides/shipping-carton-size-freight-cost/"],
    ["Responsible packaging options", "/responsible-packaging/"],
  ],
};
const defaultProductGuideLinks: [string, string][] = [
  ["What is the MOQ for custom printed boxes?", "/guides/custom-box-moq/"],
  ["How much do custom printed boxes cost?", "/guides/custom-box-cost/"],
  ["Custom box dieline guide", "/guides/custom-box-dieline-guide/"],
];
const relatedGuides = productGuideLinks[product.slug] ?? defaultProductGuideLinks;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      name: product.title,
      description: product.description,
      image: `${site.url}${product.image}`,
      brand: {
        "@type": "Brand",
        name: site.name,
      },
      manufacturer: {
        "@type": "Organization",
        name: site.name,
        url: site.url,
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: product.faqs.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={`${product.title} from China`}
  description={product.description}
  path={`/products/${product.slug}/`}
  solidHeader
  schema={schema}
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">{product.keyword}</p>
        <h1>{product.title}</h1>
        <p>{product.description}</p>
        <div class="actions">
          <a class="button gold" href="/request-a-quote/">Request a quote</a>
          <a class="button light" href="/products/">All products</a>
        </div>
      </div>
    </section>
    <section class="section alt">
      <div class="wrap split">
        <div class="feature-image">
          <img src={product.image} alt={product.alt} />
        </div>
        <div>
          <p class="section-kicker">Quote details</p>
          <h2>Useful details to prepare before asking for a quote.</h2>
          <p class="lede-copy">{product.summary}</p>
          <div class="detail-grid">
            <div class="detail-card">
              <h3>Common use cases</h3>
              <ul>
                {product.uses.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="detail-card">
              <h3>Material options</h3>
              <ul>
                {product.materials.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="detail-card">
              <h3>Printing and finishes</h3>
              <ul>
                {product.finishes.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="detail-card">
              <h3>Practical checks</h3>
              <ul>
                {product.specs.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
          <div class="note-panel">
            <h3>Before asking for a quote</h3>
            <ul class="check-list">
              {product.quoteTips.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="faq">
            {product.faqs.map((item) => (
              <div class="faq-item">
                <strong>{item.q}</strong>
                <p>{item.a}</p>
              </div>
            ))}
          </div>
          <div class="note-panel">
            <h3>Helpful guides</h3>
            <ul class="link-list">
              {relatedGuides.map(([title, href]) => (
                <li><a href={href}>{title}</a></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
    <QuoteSection />
  </main>
</BaseLayout>
