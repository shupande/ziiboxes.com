---
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuoteSection from "../../components/QuoteSection.astro";
import { products } from "../../data/site";

export function getStaticPaths({ paginate }) {
  return paginate(products, { pageSize: 10 });
}

const { page } = Astro.props;
const productList = page.data;
const productCount = products.length;
const pagePath = page.currentPage === 1 ? "/products/" : `/products/${page.currentPage}/`;
const pageTitle =
  page.currentPage === 1 ? `${productCount}+ Custom Paper Packaging Products` : `${productCount}+ Custom Paper Packaging Products - Page ${page.currentPage}`;
const pageNumbers = Array.from({ length: page.lastPage }, (_, index) => index + 1);
---

<BaseLayout
  title={pageTitle}
  description={`Explore ${productCount}+ custom paper packaging styles for ecommerce, retail, gift, wine, spirits, tea, chocolate, electronics, supplement, pet, stationery, toy, paper bag and Amazon packaging projects.`}
  path={pagePath}
  solidHeader
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Products</p>
        <h1>{productCount}+ custom paper packaging styles for online, retail and gift projects.</h1>
        <p>Start with the product use case, then compare structure, material, size, printing, finish, handle, sample and shipping.</p>
      </div>
    </section>
    <section class="section alt">
      <div class="wrap product-grid">
        {productList.map((product) => (
          <a class="product-card" href={`/products/${product.slug}/`}>
            <img src={product.image} alt={product.alt} />
            <div class="product-copy">
              <small>{product.keyword}</small>
              <h3>{product.title}</h3>
              <p>{product.description}</p>
            </div>
          </a>
        ))}
      </div>
      {page.lastPage > 1 && (
        <nav class="pagination" aria-label="Product pagination">
          {page.currentPage > 1 ? (
            <a class="pagination-link pagination-wide" href={page.currentPage === 2 ? "/products/" : `/products/${page.currentPage - 1}/`}>Previous</a>
          ) : (
            <span class="pagination-link pagination-wide is-disabled">Previous</span>
          )}
          <div class="pagination-pages">
            {pageNumbers.map((pageNumber) => (
              <a
                class="pagination-link"
                href={pageNumber === 1 ? "/products/" : `/products/${pageNumber}/`}
                aria-current={pageNumber === page.currentPage ? "page" : undefined}
              >
                {pageNumber}
              </a>
            ))}
          </div>
          {page.currentPage < page.lastPage ? (
            <a class="pagination-link pagination-wide" href={`/products/${page.currentPage + 1}/`}>Next</a>
          ) : (
            <span class="pagination-link pagination-wide is-disabled">Next</span>
          )}
        </nav>
      )}
    </section>
    <QuoteSection />
  </main>
</BaseLayout>
