---
import BaseLayout from "../layouts/BaseLayout.astro";
import LineIcon from "../components/LineIcon.astro";
import QuoteSection from "../components/QuoteSection.astro";
import { site } from "../data/site";

const faqs = [
  {
    q: "Can custom paper boxes use recycled paper?",
    a: "Recycled paper options can be discussed at the quote stage. The right choice depends on box structure, print requirements, product weight and the documents your team needs.",
  },
  {
    q: "Can I request FSC-certified paper for custom boxes?",
    a: "If FSC-certified paper is required, mention it before quoting so material availability and documentation can be checked before sampling.",
  },
  {
    q: "What labor or supplier documents should I send?",
    a: "Send your supplier code of conduct, packaging policy, audit questionnaire, restricted material list or reporting template early. It is easier to review these before the first sample is made.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: "Responsible Paper Packaging",
      description:
        "Responsible paper packaging options for custom printed boxes, including recycled paper, FSC paper requests, plastic reduction, waste control and supplier care documents.",
      url: `${site.url}/responsible-packaging/`,
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
    },
  ],
};

const responsibilityPriorities = [
  {
    icon: "leaf",
    title: "Material requirements",
    text: "Discuss recycled content, FSC paper requests and paper grades before quoting.",
  },
  {
    icon: "recycle",
    title: "Lower-waste structure",
    text: "Right-size the box and remove mixed materials that do not add protection.",
  },
  {
    icon: "shield",
    title: "Product protection",
    text: "A damaged product creates more waste than a well-planned protective structure.",
  },
  {
    icon: "people",
    title: "Supplier requirements",
    text: "Share your code of conduct, questionnaire and document list before sampling.",
  },
];
---

<BaseLayout
  title="Responsible Paper Packaging"
  description="Responsible custom paper packaging options when you source boxes from China, including recycled paper, FSC paper requests, plastic reduction, waste control and supplier care documents."
  path="/responsible-packaging/"
  solidHeader
  schema={schema}
>
  <main class="responsibility-page">
    <section class="editorial-hero responsibility-hero">
      <div class="wrap editorial-hero-grid">
        <div class="editorial-hero-copy">
          <p class="eyebrow">Responsible packaging</p>
          <h1>Set material and supplier requirements before the sample.</h1>
          <p>
            Compare paper, structure, protection and documentation early, while the box can still be changed without restarting the project.
          </p>
          <div class="actions">
            <a class="button gold" href="/request-a-quote/">Discuss your requirements</a>
            <a class="button light" href="#responsibility-checklist">View the checklist</a>
          </div>
        </div>
        <div class="responsibility-hero-media">
          <img src="/images/products/custom-kraft-paper-bags.jpg" alt="Kraft paper packaging and carrier bags" />
          <img src="/images/folding-cartons.jpg" alt="Printed paper cartons prepared for production" />
        </div>
      </div>
    </section>

    <section class="responsibility-priority-band" aria-label="Responsible packaging priorities">
      <div class="wrap responsibility-priority-grid">
        {responsibilityPriorities.map((item) => (
          <div>
            <LineIcon name={item.icon} />
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section alt" id="responsibility-checklist">
      <div class="wrap responsibility-checklist">
        <div class="responsibility-checklist-copy">
          <p class="section-kicker">Project checklist</p>
          <h2>Confirm responsibility requirements before artwork is locked.</h2>
          <p class="lede-copy">
            The useful time to discuss environmental and supplier requirements is before the dieline, material and finish are fixed.
          </p>
          <div class="responsibility-checks">
            <div>
              <LineIcon name="layers" />
              <h3>Material choices</h3>
              <ul>
                <li>Kraft, white paperboard and corrugated board options</li>
                <li>Recycled paper discussions when the structure allows it</li>
                <li>FSC-certified paper requests checked before quoting</li>
                <li>Paper inserts when a plastic tray is not needed</li>
              </ul>
            </div>
            <div>
              <LineIcon name="recycle" />
              <h3>Lower-waste design</h3>
              <ul>
                <li>Right-size the box around product dimensions and weight</li>
                <li>Use flat-packed structures when storage and freight matter</li>
                <li>Avoid unnecessary windows, coatings or mixed materials</li>
                <li>Sample first to reduce rework before bulk production</li>
              </ul>
            </div>
            <div>
              <LineIcon name="sparkle" />
              <h3>Finish decisions</h3>
              <ul>
                <li>Keep foil, spot UV and lamination focused where they add value</li>
                <li>Ask about simpler print when the box is mainly for shipping</li>
                <li>Separate premium display goals from material goals</li>
                <li>Confirm food-contact needs before choosing paper or coating</li>
              </ul>
            </div>
            <div>
              <LineIcon name="file" />
              <h3>Supplier documents</h3>
              <ul>
                <li>Supplier code of conduct or audit questionnaire</li>
                <li>Restricted material list and packaging policy</li>
                <li>Material certificate requests for selected paper</li>
                <li>Packing details for warehouse and logistics review</li>
              </ul>
            </div>
          </div>
        </div>
        <figure class="responsibility-checklist-photo">
          <img src="/images/factory-assembly-line.jpg" alt="Paper packaging production line and workshop" />
          <figcaption>Send project-specific document requests before sampling so they can be checked with the quote.</figcaption>
        </figure>
      </div>
    </section>

    <section class="section responsibility-principles">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">Practical decisions</p>
            <h2>Start with structure, then choose paper and finishes.</h2>
          </div>
          <p>A natural-looking paper does not automatically make an oversized or poorly protected box a better choice.</p>
        </div>
        <div class="responsibility-principle-grid">
          <article>
            <span>01</span>
            <h3>Right-size the structure</h3>
            <p>Use product dimensions, weight, selling channel and destination to compare board and insert options.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Protect the product</h3>
            <p>Choose enough strength and retention for the real route instead of relying on appearance alone.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Reduce mixed materials</h3>
            <p>Review whether plastic windows, trays, coatings or decorative parts are truly needed.</p>
          </article>
          <article>
            <span>04</span>
            <h3>Document the requirement</h3>
            <p>Name the certificate, audit, report or policy your company needs before the sample is made.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section dark responsibility-supplier">
      <div class="wrap responsibility-supplier-grid">
        <div>
          <p class="section-kicker">Supplier care</p>
          <h2>Bring your supplier requirements into the project brief.</h2>
          <p>
            Larger companies may have expectations around safe working conditions, working hours, forced labor, child labor and production records. Share your code or questionnaire early so the requested information can be reviewed alongside the quote.
          </p>
          <p>
            This page is not a certificate. If your project needs a specific audit, report or document, name it clearly before sampling.
          </p>
        </div>
        <div class="responsibility-supplier-note">
          <LineIcon name="people" />
          <strong>Useful documents to send</strong>
          <span>Supplier code of conduct</span>
          <span>Audit questionnaire</span>
          <span>Restricted material list</span>
          <span>Packaging policy or reporting template</span>
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="wrap responsibility-requirements">
        <div>
          <p class="section-kicker">Quote requirements</p>
          <h2>What to send with your request.</h2>
          <p>Clear details make it easier to compare realistic materials and confirm which documents can be provided.</p>
        </div>
        <div class="responsibility-table-wrap">
          <table>
          <thead>
            <tr>
              <th>Requirement</th>
              <th>Helpful detail to send</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Recycled or FSC paper</td>
              <td>Target paper requirement, certificate request and product weight.</td>
            </tr>
            <tr>
              <td>Plastic reduction</td>
              <td>Current packaging photo and whether a paper insert can replace a tray.</td>
            </tr>
            <tr>
              <td>Supplier code</td>
              <td>Your code of conduct, audit form or supplier questionnaire.</td>
            </tr>
            <tr>
              <td>Food or cosmetic packaging</td>
              <td>Whether the product touches the box directly and which market it ships to.</td>
            </tr>
          </tbody>
          </table>
        </div>
      </div>
      <div class="wrap responsibility-faq">
        <div>
          <p class="section-kicker">Common questions</p>
          <h2>Responsible packaging questions to settle early.</h2>
        </div>
        <div class="faq">
          {faqs.map((item) => (
            <div class="faq-item">
              <strong>{item.q}</strong>
              <p>{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <QuoteSection />
  </main>
</BaseLayout>
