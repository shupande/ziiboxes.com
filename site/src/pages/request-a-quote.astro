---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteSection from "../components/QuoteSection.astro";
---

<BaseLayout
  title="Request a Custom Box Quote"
  description="Request a quote for custom printed mailer boxes, folding cartons, rigid boxes, gift boxes and shipping boxes."
  path="/request-a-quote/"
  solidHeader
>
  <main class="quote-page">
    <section class="page-hero quote-page-hero">
      <div class="wrap">
        <p class="eyebrow">Quote</p>
        <h1>Request a custom printed box quote.</h1>
        <p>Send the basics first. ZiiBoxes can reply with practical options for material, finish, sample and production.</p>
      </div>
    </section>
    <QuoteSection />
  </main>
</BaseLayout>
