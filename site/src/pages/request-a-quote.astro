---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteSection from "../components/QuoteSection.astro";
---

<BaseLayout
  title="Request a Custom Packaging Quote"
  description="Request a quote for custom printed boxes, paper bags, rigid gift boxes, inserts, samples and China-side packing support."
  path="/request-a-quote/"
  solidHeader
>
  <main class="quote-page">
    <section class="page-hero quote-page-hero">
      <div class="wrap">
        <p class="eyebrow">Quote</p>
        <h1>Request a custom packaging quote.</h1>
        <p>Send the basics first. ZiiBoxes can reply with practical options for material, finish, sample, production and China-side handoff.</p>
      </div>
    </section>
    <section class="section alt">
      <div class="wrap split">
        <div>
          <p class="section-kicker">Before you send</p>
          <h2>A rough project brief is enough to start.</h2>
          <p>
            You do not need final artwork for the first estimate. Product size, packaging style, quantity, destination and any supplier delivery or packing request are enough for a practical first reply.
          </p>
        </div>
        <div class="note-panel">
          <h3>Useful pages before quoting</h3>
          <ul class="link-list">
            <li><a href="/packaging-quote-checklist/">Packaging quote checklist</a></li>
            <li><a href="/custom-packaging-sample-process/">Custom packaging sample process</a></li>
            <li><a href="/case-studies/">Packaging case studies</a></li>
          </ul>
        </div>
      </div>
    </section>
    <QuoteSection />
  </main>
</BaseLayout>
