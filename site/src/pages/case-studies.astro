---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteSection from "../components/QuoteSection.astro";
import { caseStudies } from "../data/caseStudies";
import { site } from "../data/site";

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Packaging Case Studies",
  description:
    "Custom paper packaging case studies and project route examples from ZiiBoxes, including gift boxes, paper bags, sampling and China-side supplier handoff.",
  url: `${site.url}/case-studies/`,
};
---

<BaseLayout
  title="Packaging Case Studies"
  description="Custom paper packaging case studies and project route examples from ZiiBoxes, including gift boxes, paper bags, sampling and China-side supplier handoff."
  path="/case-studies/"
  solidHeader
  schema={schema}
>
  <main>
    <section class="case-hero">
      <div class="wrap case-hero-grid">
        <div>
          <p class="eyebrow">Case studies</p>
          <h1>Custom packaging case studies from China.</h1>
          <p>
            Use these examples to see how custom boxes, paper bags, sampling, supplier delivery, packing notes and freight handoff can fit together before goods leave China.
          </p>
        </div>
        <div class="case-facts" aria-label="Project facts">
          <div>
            <span>Real case</span>
            <strong>UK rigid gift boxes</strong>
          </div>
          <div>
            <span>Workflow examples</span>
            <strong>Paper bags and bottle boxes</strong>
          </div>
          <div>
            <span>Buyer focus</span>
            <strong>Less remote coordination</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-kicker">Project examples</p>
            <h2>Proof and planning routes before you ask for a quote.</h2>
          </div>
          <p>
            Client names and exact product details can stay private. The useful part is the route: what problem needed solving and how the packaging work was organized.
          </p>
        </div>
        <div class="product-grid">
          {caseStudies.map((caseStudy) => (
            <a class="product-card" href={`/case-studies/${caseStudy.slug}/`}>
              <img src={caseStudy.image} alt={caseStudy.alt} />
              <div class="product-copy">
                <small>{caseStudy.eyebrow}</small>
                <h3>{caseStudy.title}</h3>
                <p>{caseStudy.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap split">
        <div>
          <p class="section-kicker">What buyers usually want to know</p>
          <h2>Good packaging work is usually about the handoff, not only the print.</h2>
          <p>
            A box or bag can look finished, but the buyer may still need sampling decisions, product packing, supplier delivery, carton information or paperwork support.
            These pages show how those details are handled earlier.
          </p>
        </div>
        <div class="note-panel">
          <h3>Useful next pages</h3>
          <ul class="link-list">
            <li><a href="/custom-packaging-sample-process/">Custom packaging sample process</a></li>
            <li><a href="/packaging-quote-checklist/">Packaging quote checklist</a></li>
            <li><a href="/china-packaging-agent/">China packaging agent</a></li>
            <li><a href="/product-packing-service-china/">Product packing service in China</a></li>
          </ul>
        </div>
      </div>
    </section>

    <QuoteSection />
  </main>
</BaseLayout>
