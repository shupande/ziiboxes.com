---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteSection from "../components/QuoteSection.astro";
import { site } from "../data/site";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Packaging Case Studies",
  description:
    "Real custom paper packaging project examples from ZiiBoxes, including gift box production, China-side supplier collection, logistics coordination and export paperwork support.",
  url: `${site.url}/case-studies/`,
};
---

<BaseLayout
  title="Packaging Case Studies"
  description="Real custom paper packaging project examples from ZiiBoxes, including gift box production, China-side supplier collection, logistics coordination and export paperwork support."
  path="/case-studies/"
  solidHeader
  schema={schema}
>
  <main>
    <section class="case-hero">
      <div class="wrap case-hero-grid">
        <div>
          <p class="eyebrow">Case studies</p>
          <h1>Real packaging projects with China-side support.</h1>
          <p>
            These examples show how custom boxes, supplier collection, packing details and freight handoff can work in real projects. Client names can stay private when needed.
          </p>
        </div>
        <div class="case-facts" aria-label="Project facts">
          <div>
            <span>Market</span>
            <strong>United Kingdom</strong>
          </div>
          <div>
            <span>Quantity</span>
            <strong>About 20,000 pcs</strong>
          </div>
          <div>
            <span>Box style</span>
            <strong>Lid-and-base rigid box</strong>
          </div>
          <div>
            <span>Extra work</span>
            <strong>China-side export support</strong>
          </div>
          <div>
            <span>Delivery</span>
            <strong>100% on time</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="wrap case-story">
        <figure class="case-photo">
          <img src="/images/rigid-boxes.jpg" alt="Open rigid lid-and-base gift boxes for an export packaging project" />
          <figcaption>Rigid lid-and-base structure used for premium gift packaging projects.</figcaption>
        </figure>
        <article>
          <p class="section-kicker">UK gift box project</p>
          <h2>20,000 rigid lid-and-base gift boxes, plus China-side export coordination.</h2>
          <p>
            A UK customer needed about 20,000 gift boxes in a rigid lid-and-base structure. The project also needed China-side coordination because goods from other Chinese suppliers had to be collected before export.
          </p>

          <div class="case-timeline">
            <div class="case-step">
              <span>01</span>
              <div>
                <h3>Make the gift boxes</h3>
                <p>Produced about 20,000 rigid lid-and-base boxes and discussed export carton details before shipment.</p>
              </div>
            </div>
            <div class="case-step">
              <span>02</span>
              <div>
                <h3>Collect supplier goods in China</h3>
                <p>Gathered goods from other Chinese suppliers so the customer did not need to manage every handoff remotely.</p>
              </div>
            </div>
            <div class="case-step">
              <span>03</span>
              <div>
                <h3>Find the freight route</h3>
                <p>Helped find a suitable logistics provider, then coordinated container loading details.</p>
              </div>
            </div>
            <div class="case-step">
              <span>04</span>
              <div>
                <h3>Prepare paperwork support</h3>
                <p>Supported customs paperwork and clearance coordination, including dangerous-goods paperwork for granular cargo.</p>
              </div>
            </div>
          </div>

          <div class="case-feedback">
            <h3>Customer feedback</h3>
            <p>
              The customer said the box quality was very good and thanked us for helping with dangerous-goods paperwork and customs clearance coordination for granular cargo.
            </p>
          </div>

          <div class="case-results">
            <div>
              <strong>Quality confirmed</strong>
              <p>The customer was happy with the finished box quality.</p>
            </div>
            <div>
              <strong>Fewer handoffs</strong>
              <p>Packaging and supplier goods were organized for one export route.</p>
            </div>
            <div>
              <strong>100% on-time delivery</strong>
              <p>The shipment reached the agreed delivery timing.</p>
            </div>
            <div>
              <strong>Clearer shipment prep</strong>
              <p>Loading and paperwork details were handled before shipment.</p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <QuoteSection />
  </main>
</BaseLayout>
