---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  path?: string;
  solidHeader?: boolean;
  schema?: unknown;
}

const { title, description, path = "/", solidHeader = false, schema } = Astro.props;
const canonical = new URL(path, site.url).toString();
const pageTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const hasGtm = Boolean(gtmId);
const default51LaId = "3QfvQ1OTkQxxXCtj";
const la51Id = import.meta.env.PUBLIC_51LA_ID ?? default51LaId;
const la51Ck = import.meta.env.PUBLIC_51LA_CK ?? la51Id;
const has51La = Boolean(la51Id && la51Ck);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {hasGtm && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',${JSON.stringify(gtmId)});`} />
    )}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${site.url}/images/mailer-boxes.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    {hasGtm && (
      <noscript>
        <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
      </noscript>
    )}
    <header class:list={["site-header", { solid: solidHeader }]}>
      <nav class="nav wrap" aria-label="Primary navigation">
        <a class="brand" href="/">
          <img src="/images/logo.png" alt="ZiiBoxes" />
        </a>
        <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-controls="primary-menu" aria-expanded="false" data-nav-toggle>
          <span></span>
          <span></span>
          <span></span>
        </button>
        <div class="nav-links" id="primary-menu">
          <a href="/products/">Products</a>
          <a href="/industries/">Industries</a>
          <a href="/case-studies/">Cases</a>
          <a href="/services/">Process</a>
          <a href="/guides/">Blog</a>
          <a href="/responsible-packaging/">Responsibility</a>
          <a class="nav-quote" href="/request-a-quote/">Request a quote</a>
        </div>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <strong>{site.name}</strong>
          <p>{site.description}</p>
          <p>{site.location}</p>
        </div>
        <div>
          <strong>Products</strong>
          <a href="/products/custom-mailer-boxes/">Mailer boxes</a>
          <a href="/products/custom-folding-cartons/">Folding cartons</a>
          <a href="/products/custom-rigid-boxes/">Rigid boxes</a>
          <a href="/custom-rigid-gift-boxes-china/">Rigid gift boxes</a>
          <a href="/cosmetic-gift-set-packaging-china/">Cosmetic gift sets</a>
        </div>
        <div>
          <strong>Use cases</strong>
          <a href="/china-packaging-agent/">China packaging agent</a>
          <a href="/amazon-private-label-packaging-china/">Amazon private label packaging</a>
          <a href="/jewelry-packaging-china/">Jewelry packaging</a>
          <a href="/candle-packaging-china/">Candle packaging</a>
          <a href="/soap-packaging-china/">Soap packaging</a>
          <a href="/apparel-packaging-china/">Apparel packaging</a>
          <a href="/perfume-packaging-china/">Perfume packaging</a>
          <a href="/bakery-food-packaging-china/">Bakery food packaging</a>
          <a href="/product-packing-service-china/">Product packing in China</a>
          <a href="/send-packaging-to-china-supplier/">Send boxes to China supplier</a>
          <a href="/amazon-fba-packaging-prep-china/">Amazon FBA packaging prep</a>
          <a href="/shopify-packaging-china/">Shopify packaging</a>
          <a href="/ecommerce-packaging/">Ecommerce packaging</a>
          <a href="/case-studies/">Case studies</a>
        </div>
        <div>
          <strong>Blog</strong>
          <a href="/guides/custom-box-moq/">MOQ guide</a>
          <a href="/guides/custom-box-cost/">Cost guide</a>
          <a href="/guides/artwork-file-checklist/">Artwork checklist</a>
          <a href="/responsible-packaging/">Responsible packaging</a>
        </div>
        <div>
          <strong>Contact</strong>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.whatsapp}>WhatsApp</a>
          <a href="/request-a-quote/">Request a quote</a>
        </div>
      </div>
    </footer>
    <button class="back-to-top" type="button" aria-label="Back to top" data-back-to-top hidden></button>
    {has51La && (
      <>
        <script is:inline charset="UTF-8" id="LA_COLLECT" src="https://sdk.51.la/js-sdk-pro.min.js"></script>
        <script is:inline set:html={`window.LA && window.LA.init && window.LA.init({id:${JSON.stringify(la51Id)},ck:${JSON.stringify(la51Ck)}});`} />
      </>
    )}
    <script>
      const navToggle = document.querySelector("[data-nav-toggle]");
      const navMenu = document.querySelector("#primary-menu");

      if (navToggle && navMenu) {
        navToggle.addEventListener("click", () => {
          const isOpen = navToggle.getAttribute("aria-expanded") === "true";
          navToggle.setAttribute("aria-expanded", String(!isOpen));
          navMenu.classList.toggle("is-open", !isOpen);
        });

        navMenu.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            navToggle.setAttribute("aria-expanded", "false");
            navMenu.classList.remove("is-open");
          });
        });
      }

      const backToTop = document.querySelector("[data-back-to-top]");

      if (backToTop) {
        const toggleBackToTop = () => {
          backToTop.toggleAttribute("hidden", window.scrollY < 600);
        };

        backToTop.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });

        window.addEventListener("scroll", toggleBackToTop, { passive: true });
        toggleBackToTop();
      }
    </script>
  </body>
</html>
